                                                           "kind":  "text"
                                                       },
                                                       {
                                                           "content":  "\\displaystyle \\frac{0.2}{1-0.2}=\\frac{1}{4}=K",
                                                           "display":  true,
                                                           "kind":  "math"
                                                       },
                                                       {
                                                           "content":  "\\displaystyle y(x)=\\frac{\\tfrac{1}{4}e^{x}}{1+\\tfrac{1}{4}e^{x}}=\\frac{1}{1+4e^{-x}}",
