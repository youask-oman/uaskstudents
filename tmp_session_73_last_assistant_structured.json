                                                       {
                                                           "content":  "The ODE dy/dx = y(1-y) is separable since the right-hand side factors into functions of y alone.",
                                                           "display":  true,
                                                           "kind":  "text"
                                                       }
                                                   ],
                                        "index":  1,
                                        "title":  "Show separable"
                                    },
                                    {
                                        "blocks":  [
                                                       {
                                                           "content":  "\\displaystyle \\frac{1}{y(1-y)}\\,dy=dx",
                                                           "display":  true,
                                                           "kind":  "math"
                                                       },
                                                       {
                                                           "content":  "Integrate both sides.",
                                                           "display":  true,
                                                           "kind":  "text"
                                                       },
                                                       {
                                                           "content":  "\\displaystyle \\int\\left(\\frac{1}{y} + \\frac{1}{1-y}\\right)dy = \\int dx",
                                                           "display":  true,
                                                           "kind":  "math"
                                                       },
                                                       {
                                                           "content":  "\\displaystyle \\ln|y| - \\ln|1-y| = x + C",
                                                           "display":  true,
                                                           "kind":  "math"
                                                       }
                                                   ],
                                        "index":  2,
                                        "title":  "Separate and integrate"
                                    },
                                    {
                                        "blocks":  [
                                                       {
                                                           "content":  "\\displaystyle \\ln\\left(\\frac{y}{1-y}\\right)=x+C",
                                                           "display":  true,
                                                           "kind":  "math"
                                                       },
                                                       {
                                                           "content":  "Exponentiate and solve for y.",
                                                           "display":  true,
                                                           "kind":  "text"
                                                       },
                                                       {
                                                           "content":  "\\displaystyle \\frac{y}{1-y}=Ke^{x}\\quad\\Rightarrow\\quad y=\\frac{Ke^{x}}{1+Ke^{x}}",
                                                           "display":  true,
                                                           "kind":  "math"
                                                       }
                                                   ],
                                        "index":  3,
                                        "title":  "Solve for y explicitly"
                                    },
                                    {
