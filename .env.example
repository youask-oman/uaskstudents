OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL_TUTOR=gpt-5.2
OPENAI_MODEL_ESCALATE=o3
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_DEFAULT=gpt-5-mini
SOLVER_V2_ENABLED=true

# LLM Provider Selection
LLM_PROVIDER=ollama
LLM_FALLBACK_ENABLED=true
LLM_DEBUG_LOGS=false

# Ollama Configuration
OLLAMA_BASE_URL=http://172.26.131.128:11434
OLLAMA_MODEL_DEFAULT=mightykatun/qwen2.5-math:7b
OLLAMA_OCR_MODEL=qwen2.5vl:3b
OCR_QWEN_SYSTEM_PROMPT_ID=ocr_extract_qwen_system_v1
OCR_QWEN_USER_PROMPT_ID=ocr_extract_qwen_user_v1
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_MAX_RETRIES=2
OLLAMA_KEEPALIVE=5m
OLLAMA_CONTEXT_TOKENS=4096
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_P=0.9
LLM_REPAIR_ENABLED=true
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SNAP_SOLVE_UPLOAD_PANEL_V2=true
NEXT_PUBLIC_MATH_RENDERER=katex
NEXT_PUBLIC_MATH_ENGINE=mathjax
