{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youask.ai/schemas/youask_math_solver_response_v1.json",
  "title": "YouAsk Math Solver Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "question_id",
    "tier",
    "mode",
    "language",
    "question",
    "solution",
    "plot",
    "verification",
    "meta"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "v1"
    },

    "question_id": {
      "type": "string",
      "description": "Single question identifier. Exactly one per call."
    },

    "tier": {
      "type": "string",
      "enum": ["FREE", "STANDARD", "RESEARCH"]
    },

    "mode": {
      "type": "string",
      "enum": ["SOLVE", "VERIFY", "PLOT_ONLY"]
    },

    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["response_language", "english_only_enforced"],
      "properties": {
        "response_language": {
          "type": "string",
          "description": "Language used in all natural-language fields in this JSON.",
          "enum": ["en", "fr", "es", "pt", "it", "ar"]
        },
        "english_only_enforced": {
          "type": "boolean",
          "description": "True if system enforces English-only regardless of input language."
        },
        "input_language_hint": {
          "type": ["string", "null"],
          "description": "Optional best-effort guess of input language.",
          "enum": ["en", "fr", "es", "pt", "it", "ar", null]
        }
      }
    },

    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_text", "normalized_text"],
      "properties": {
        "raw_text": {
          "type": "string",
          "description": "Original extracted text (OCR/VLM/PDF extract)."
        },
        "normalized_text": {
          "type": "string",
          "description": "Canonicalized version used for fingerprinting/search."
        },
        "assumptions": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "constraints": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },

    "solution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "steps", "final_answer"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["ok", "needs_clarification", "error"]
        },
        "steps": {
          "type": "array",
          "description": "Ordered steps for the solution. Minimal for FREE tier.",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["step_id", "title", "content"],
            "properties": {
              "step_id": { "type": "integer", "minimum": 1 },
              "title": { "type": "string" },
              "content": {
                "type": "string",
                "description": "English prose + LaTeX allowed."
              },
              "latex": {
                "type": ["string", "null"],
                "description": "Optional LaTeX block for the step.",
                "default": null
              }
            }
          }
        },
        "final_answer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "latex"],
          "properties": {
            "value": {
              "type": "string",
              "description": "Plain-text final answer."
            },
            "latex": {
              "type": "string",
              "description": "LaTeX representation of the final answer."
            },
            "units": {
              "type": ["string", "null"],
              "default": null
            }
          }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },

    "plot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plot_needed", "plot_reason", "plot_specs"],
      "properties": {
        "plot_needed": {
          "type": "boolean",
          "description": "True if a plot would help understanding or is required."
        },
        "plot_reason": {
          "type": ["string", "null"],
          "description": "Short reason why plot is needed.",
          "default": null
        },
        "plot_specs": {
          "type": ["array", "null"],
          "description": "Only populated when mode=PLOT_ONLY or a later stage generates plots.",
          "default": null,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["plot_id", "library", "spec"],
            "properties": {
              "plot_id": { "type": "string" },
              "library": { "type": "string", "enum": ["plotly"] },
              "spec": {
                "type": "object",
                "description": "Plotly JSON spec."
              },
              "attach_to_step_id": {
                "type": ["integer", "null"],
                "default": null
              }
            }
          }
        }
      }
    },

    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "status", "checks"],
      "properties": {
        "requested": {
          "type": "boolean",
          "description": "Whether verification was requested by flags."
        },
        "status": {
          "type": "string",
          "enum": ["not_requested", "verified", "partially_verified", "failed", "error"]
        },
        "checks": {
          "type": "array",
          "description": "Per-check results. Keep empty unless verification is run.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check_id", "verdict", "message"],
            "properties": {
              "check_id": { "type": "string" },
              "verdict": { "type": "string", "enum": ["pass", "warn", "fail"] },
              "message": { "type": "string" },
              "related_step_id": { "type": ["integer", "null"], "default": null }
            }
          }
        }
      }
    },

    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "timestamps",
        "latency_ms",
        "fingerprint",
        "cache"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["ollama", "openai", "other"]
        },
        "model": { "type": "string" },
        "timestamps": {
          "type": "object",
          "additionalProperties": false,
          "required": ["started_at", "completed_at"],
          "properties": {
            "started_at": { "type": "string", "format": "date-time" },
            "completed_at": { "type": "string", "format": "date-time" }
          }
        },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "fingerprint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["normalized_sha256"],
          "properties": {
            "normalized_sha256": { "type": "string" }
          }
        },
        "cache": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hit", "type"],
          "properties": {
            "hit": { "type": "boolean" },
            "type": {
              "type": "string",
              "enum": ["none", "exact", "semantic"]
            },
            "source_question_id": { "type": ["string", "null"], "default": null }
          }
        },
        "debug": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prompt_version": { "type": ["string", "null"], "default": null },
            "schema_valid": { "type": ["boolean", "null"], "default": null },
            "fallback_used": { "type": ["boolean", "null"], "default": null }
          },
          "default": {}
        }
      }
    }
  }
}
