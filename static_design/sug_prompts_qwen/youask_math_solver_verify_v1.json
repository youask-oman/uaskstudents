{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youask.ai/schemas/youask_math_solver_verify_v1.json",
  "title": "YouAsk Math Solver Verify v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "response_type",
    "question_id",
    "tier",
    "mode",
    "language",
    "question",
    "input_solution",
    "verification",
    "plot",
    "meta"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "v1" },

    "response_type": { "type": "string", "const": "verify" },

    "question_id": { "type": "string" },

    "tier": {
      "type": "string",
      "description": "Verification can be used across tiers; keep the tier value passed by the system.",
      "enum": ["FREE", "STANDARD", "RESEARCH"]
    },

    "mode": { "type": "string", "const": "VERIFY" },

    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["response_language", "english_only_enforced"],
      "properties": {
        "response_language": { "type": "string", "enum": ["en"] },
        "english_only_enforced": { "type": "boolean", "const": true },
        "input_language_hint": {
          "type": ["string", "null"],
          "enum": ["en", "fr", "es", "pt", "it", "ar", null],
          "default": null
        }
      }
    },

    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_text", "normalized_text"],
      "properties": {
        "raw_text": { "type": "string" },
        "normalized_text": { "type": "string" }
      }
    },

    "input_solution": {
      "type": "object",
      "description": "The solution JSON to verify. Structure must match the solver schema used upstream.",
      "additionalProperties": true
    },

    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "overall_verdict", "per_step", "final_answer_check"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["verified", "verified_with_warnings", "warning", "error"]
        },

        "overall_verdict": {
          "type": "string",
          "enum": ["verified", "warning"]
        },

        "per_step": {
          "type": "array",
          "description": "One entry per step_id found in the input_solution. Must reference step_id.",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["step_id", "verdict", "reason", "suggested_correction"],
            "properties": {
              "step_id": { "type": "integer", "minimum": 1 },
              "verdict": {
                "type": "string",
                "enum": ["verified", "warning"]
              },
              "reason": {
                "type": "string",
                "description": "Short English explanation; do not re-solve."
              },
              "suggested_correction": {
                "type": ["string", "null"],
                "description": "Minimal correction only if needed; otherwise null.",
                "default": null
              }
            }
          }
        },

        "final_answer_check": {
          "type": "object",
          "additionalProperties": false,
          "required": ["verdict", "reason", "suggested_correction"],
          "properties": {
            "verdict": { "type": "string", "enum": ["verified", "warning"] },
            "reason": { "type": "string" },
            "suggested_correction": { "type": ["string", "null"], "default": null }
          }
        }
      }
    },

    "plot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plot_needed", "plot_reason"],
      "properties": {
        "plot_needed": {
          "type": "boolean",
          "description": "Usually false for verify, but can be true if a plot is needed to validate a claim."
        },
        "plot_reason": { "type": ["string", "null"], "default": null }
      }
    },

    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "timestamps",
        "latency_ms",
        "debug"
      ],
      "properties": {
        "provider": { "type": "string", "enum": ["ollama", "openai", "other"] },
        "model": { "type": "string" },

        "timestamps": {
          "type": "object",
          "additionalProperties": false,
          "required": ["started_at", "completed_at"],
          "properties": {
            "started_at": { "type": "string", "format": "date-time" },
            "completed_at": { "type": "string", "format": "date-time" }
          }
        },

        "latency_ms": { "type": "integer", "minimum": 0 },

        "debug": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prompt_id", "schema_valid", "fallback_used"],
          "properties": {
            "prompt_id": { "type": "string" },
            "schema_valid": { "type": "boolean" },
            "fallback_used": { "type": "boolean" }
          }
        }
      }
    }
  }
}
