{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uask.ai/schemas/image_extract_v1.json",
  "title": "image_extract_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "source", "pages", "questions", "figures", "warnings", "needs_human_review", "usage"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "image_extract_v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "file_name", "page_count"],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": ["image", "pdf"]
        },
        "file_name": {
          "type": ["string", "null"]
        },
        "page_count": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page_index", "width_px", "height_px", "rotation_degrees", "segments"],
        "properties": {
          "page_index": { "type": "integer", "minimum": 0 },
          "width_px": { "type": ["integer", "null"], "minimum": 1 },
          "height_px": { "type": ["integer", "null"], "minimum": 1 },
          "rotation_degrees": { "type": "integer", "enum": [0, 90, 180, 270] },
          "segments": {
            "type": "array",
            "items": { "$ref": "#/$defs/segment" }
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": { "$ref": "#/$defs/question" }
    },
    "figures": {
      "type": "array",
      "items": { "$ref": "#/$defs/figure" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "needs_human_review": {
      "type": "boolean"
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "tokens_in", "tokens_out"],
      "properties": {
        "provider": { "type": "string", "enum": ["pix2txt", "qwen", "openai"] },
        "model": { "type": "string", "minLength": 1 },
        "tokens_in": { "type": ["integer", "null"], "minimum": 0 },
        "tokens_out": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  },
  "$defs": {
    "bbox_norm": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "description": "[x1,y1,x2,y2] normalized to page dimensions"
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_id", "page_index", "kind", "bbox", "text", "latex", "confidence", "notes"],
      "properties": {
        "segment_id": { "type": "string", "minLength": 1 },
        "page_index": { "type": "integer", "minimum": 0 },
        "kind": {
          "type": "string",
          "enum": ["title", "instruction", "question_text", "equation", "table", "figure_caption", "answer_choices", "other"]
        },
        "bbox": { "$ref": "#/$defs/bbox_norm" },
        "text": {
          "type": "string",
          "description": "Plain transcription preserving line breaks where possible."
        },
        "latex": {
          "type": "string",
          "description": "Same content as text but with mathematical parts rendered in LaTeX (no $ delimiters)."
        },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "notes": {
          "type": "string",
          "description": "Use for uncertainty markers like [illegible] or [uncertain]."
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "page_index",
        "bbox",
        "question_number",
        "question_text",
        "question_latex",
        "subparts",
        "answer_choices",
        "figure_refs",
        "confidence"
      ],
      "properties": {
        "question_id": { "type": "string", "minLength": 1 },
        "page_index": { "type": "integer", "minimum": 0 },
        "bbox": { "$ref": "#/$defs/bbox_norm" },
        "question_number": { "type": ["string", "null"], "description": "e.g., '1', '2', 'Q3'. null if none visible." },
        "question_text": { "type": "string" },
        "question_latex": { "type": "string" },
        "subparts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "text", "latex", "bbox", "confidence"],
            "properties": {
              "label": { "type": ["string", "null"], "description": "e.g., '(a)', '(i)'. null if not applicable." },
              "text": { "type": "string" },
              "latex": { "type": "string" },
              "bbox": { "$ref": "#/$defs/bbox_norm" },
              "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
            }
          }
        },
        "answer_choices": {
          "type": "array",
          "description": "MCQ options if present. Keep order.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "text", "latex", "confidence"],
            "properties": {
              "label": { "type": ["string", "null"], "description": "e.g., 'A', 'B', 'C', 'D'." },
              "text": { "type": "string" },
              "latex": { "type": "string" },
              "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
            }
          }
        },
        "figure_refs": {
          "type": "array",
          "description": "IDs of referenced figures from figures[].",
          "items": { "type": "string" }
        },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "figure_id",
        "page_index",
        "kind",
        "bbox",
        "caption",
        "graph",
        "geometry",
        "table",
        "confidence"
      ],
      "properties": {
        "figure_id": { "type": "string", "minLength": 1 },
        "page_index": { "type": "integer", "minimum": 0 },
        "kind": { "type": "string", "enum": ["graph", "geometry", "table", "diagram", "unknown"] },
        "bbox": { "$ref": "#/$defs/bbox_norm" },
        "caption": { "type": ["string", "null"] },
        "graph": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x_label", "y_label", "x_range", "y_range", "ticks", "plotted_description"],
          "properties": {
            "x_label": { "type": ["string", "null"] },
            "y_label": { "type": ["string", "null"] },
            "x_range": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": ["number", "null"] }
            },
            "y_range": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": ["number", "null"] }
            },
            "ticks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["axis", "value", "label"],
                "properties": {
                  "axis": { "type": "string", "enum": ["x", "y"] },
                  "value": { "type": ["number", "null"] },
                  "label": { "type": ["string", "null"] }
                }
              }
            },
            "plotted_description": {
              "type": ["string", "null"],
              "description": "Describe what is plotted without guessing formulas if unclear."
            }
          }
        },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["labeled_points", "labeled_segments", "labeled_angles", "notes"],
          "properties": {
            "labeled_points": {
              "type": "array",
              "items": { "type": "string" }
            },
            "labeled_segments": {
              "type": "array",
              "items": { "type": "string" }
            },
            "labeled_angles": {
              "type": "array",
              "items": { "type": "string" }
            },
            "notes": { "type": ["string", "null"] }
          }
        },
        "table": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rows"],
          "properties": {
            "rows": {
              "type": "array",
              "items": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    }
  }
}
