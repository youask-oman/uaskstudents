{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youask.ai/schemas/youask_math_solver_research_solve_v1.json",
  "title": "YouAsk Math Solver Research Solve v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "response_type",
    "question_id",
    "tier",
    "mode",
    "language",
    "question",
    "solution",
    "plot",
    "verification",
    "meta"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "v1" },

    "response_type": { "type": "string", "const": "research_solve" },

    "question_id": { "type": "string" },

    "tier": { "type": "string", "const": "RESEARCH" },

    "mode": { "type": "string", "const": "SOLVE" },

    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["response_language", "english_only_enforced"],
      "properties": {
        "response_language": { "type": "string", "enum": ["en"] },
        "english_only_enforced": { "type": "boolean", "const": true },
        "input_language_hint": {
          "type": ["string", "null"],
          "enum": ["en", "fr", "es", "pt", "it", "ar", null],
          "default": null
        }
      }
    },

    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_text", "normalized_text"],
      "properties": {
        "raw_text": { "type": "string" },
        "normalized_text": { "type": "string" },
        "assumptions": { "type": "array", "items": { "type": "string" }, "default": [] },
        "constraints": { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    },

    "solution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "steps",
        "final_answer",
        "key_idea",
        "checks",
        "alternate_approach"
      ],
      "properties": {
        "status": { "type": "string", "enum": ["ok", "needs_clarification", "error"] },

        "steps": {
          "type": "array",
          "description": "Research tier: deeper but still bounded. Clear, rigorous steps.",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["step_id", "title", "explanation", "math", "result"],
            "properties": {
              "step_id": { "type": "integer", "minimum": 1 },
              "title": { "type": "string" },
              "explanation": { "type": "string" },
              "math": { "type": "array", "items": { "type": "string" }, "default": [] },
              "result": { "type": ["string", "null"], "default": null },
              "rigor_note": {
                "type": ["string", "null"],
                "description": "Optional brief rigor note (e.g., justify a step, domain note).",
                "default": null
              },
              "attach_plot_hint": { "type": ["boolean", "null"], "default": null }
            }
          }
        },

        "final_answer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "latex", "units"],
          "properties": {
            "value": { "type": "string" },
            "latex": { "type": "string" },
            "units": { "type": ["string", "null"], "default": null }
          }
        },

        "key_idea": {
          "type": ["string", "null"],
          "description": "Optional brief insight/key idea (1–3 sentences).",
          "default": null
        },

        "checks": {
          "type": "array",
          "description": "Inline correctness checks performed as part of solving (not the separate verify mode).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check_id", "type", "verdict", "message", "related_step_id"],
            "properties": {
              "check_id": { "type": "string" },
              "type": {
                "type": "string",
                "enum": [
                  "domain_check",
                  "units_check",
                  "substitution_check",
                  "boundary_check",
                  "sanity_check",
                  "algebra_check",
                  "numerical_check"
                ]
              },
              "verdict": { "type": "string", "enum": ["pass", "warn", "fail"] },
              "message": { "type": "string" },
              "related_step_id": { "type": ["integer", "null"], "default": null }
            }
          },
          "default": []
        },

        "alternate_approach": {
          "type": ["object", "null"],
          "description": "Optional alternate approach included only if it adds value and fits output cap.",
          "default": null,
          "additionalProperties": false,
          "required": ["included", "title", "summary_steps", "final_consistency"],
          "properties": {
            "included": { "type": "boolean" },
            "title": { "type": "string" },
            "summary_steps": {
              "type": "array",
              "description": "Short outline (not a full duplicate solution).",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["step_id", "content"],
                "properties": {
                  "step_id": { "type": "integer", "minimum": 1 },
                  "content": { "type": "string" }
                }
              }
            },
            "final_consistency": {
              "type": "object",
              "additionalProperties": false,
              "required": ["matches_main_final_answer", "note"],
              "properties": {
                "matches_main_final_answer": { "type": "boolean" },
                "note": { "type": ["string", "null"], "default": null }
              }
            }
          }
        }
      }
    },

    "plot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plot_needed", "plot_reason", "plot_intents", "plot_specs"],
      "properties": {
        "plot_needed": { "type": "boolean" },
        "plot_reason": { "type": ["string", "null"], "default": null },

        "plot_intents": {
          "type": ["array", "null"],
          "description": "Hints for a plot worker (what to plot and why), without full plot specs.",
          "default": null,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["intent_id", "type", "description", "attach_to_step_id"],
            "properties": {
              "intent_id": { "type": "string" },
              "type": {
                "type": "string",
                "enum": [
                  "function_plot_2d",
                  "inequality_region_2d",
                  "parametric_2d",
                  "scatter_fit",
                  "geometry_sketch",
                  "graph_of_sequence",
                  "histogram",
                  "boxplot",
                  "complex_plane"
                ]
              },
              "description": { "type": "string" },
              "attach_to_step_id": { "type": ["integer", "null"], "default": null },
              "variables": {
                "type": "array",
                "items": { "type": "string" },
                "default": []
              },
              "domain_hint": { "type": ["string", "null"], "default": null }
            }
          }
        },

        "plot_specs": {
          "type": ["array", "null"],
          "default": null,
          "description": "Not generated in SOLVE mode; reserved for PLOT_ONLY or plot worker stage.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["plot_id", "library", "spec"],
            "properties": {
              "plot_id": { "type": "string" },
              "library": { "type": "string", "enum": ["plotly"] },
              "spec": { "type": "object" },
              "attach_to_step_id": { "type": ["integer", "null"], "default": null }
            }
          }
        }
      }
    },

    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "status", "checks"],
      "properties": {
        "requested": { "type": "boolean" },
        "status": {
          "type": "string",
          "enum": ["not_requested", "verified", "partially_verified", "failed", "error"]
        },
        "checks": {
          "type": "array",
          "description": "Reserved for VERIFY mode; keep empty unless verification is executed.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check_id", "verdict", "message", "related_step_id"],
            "properties": {
              "check_id": { "type": "string" },
              "verdict": { "type": "string", "enum": ["pass", "warn", "fail"] },
              "message": { "type": "string" },
              "related_step_id": { "type": ["integer", "null"], "default": null }
            }
          }
        }
      }
    },

    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "timestamps",
        "latency_ms",
        "fingerprint",
        "cache",
        "debug"
      ],
      "properties": {
        "provider": { "type": "string", "enum": ["ollama", "openai", "other"] },
        "model": { "type": "string" },

        "timestamps": {
          "type": "object",
          "additionalProperties": false,
          "required": ["started_at", "completed_at"],
          "properties": {
            "started_at": { "type": "string", "format": "date-time" },
            "completed_at": { "type": "string", "format": "date-time" }
          }
        },

        "latency_ms": { "type": "integer", "minimum": 0 },

        "fingerprint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["normalized_sha256"],
          "properties": {
            "normalized_sha256": { "type": "string" }
          }
        },

        "cache": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hit", "type", "source_question_id"],
          "properties": {
            "hit": { "type": "boolean" },
            "type": { "type": "string", "enum": ["none", "exact", "semantic"] },
            "source_question_id": { "type": ["string", "null"], "default": null }
          }
        },

        "debug": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prompt_id", "schema_valid", "fallback_used", "output_cap_tokens"],
          "properties": {
            "prompt_id": { "type": "string" },
            "schema_valid": { "type": "boolean" },
            "fallback_used": { "type": "boolean" },
            "output_cap_tokens": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
