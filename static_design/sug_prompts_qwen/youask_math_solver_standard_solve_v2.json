{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youask.ai/schemas/youask_math_solver_standard_solve_v2.json",
  "title": "YouAsk Math Solver Standard Solve v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "response_type",
    "question_id",
    "tier",
    "mode",
    "language",
    "question",
    "solution",
    "plot",
    "verification",
    "meta"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "v2"
    },
    "response_type": {
      "type": "string",
      "const": "standard_solve"
    },
    "question_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "default": null
    },
    "tier": {
      "type": "string",
      "const": "STANDARD"
    },
    "mode": {
      "type": "string",
      "const": "SOLVE"
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["response_language", "english_only_enforced"],
      "properties": {
        "response_language": {
          "type": "string",
          "enum": ["en"]
        },
        "english_only_enforced": {
          "type": "boolean",
          "const": true
        },
        "input_language_hint": {
          "type": ["string", "null"],
          "enum": ["en", "fr", "es", "pt", "it", "ar", null],
          "default": null
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_text", "normalized_text"],
      "properties": {
        "raw_text": {
          "type": "string",
          "minLength": 1
        },
        "normalized_text": {
          "type": "string",
          "minLength": 1
        },
        "assumptions": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "constraints": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "solution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "steps", "final_answer", "key_idea"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["ok", "needs_clarification", "error"]
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["step_id", "title", "explanation", "math"],
            "properties": {
              "step_id": {
                "type": "integer",
                "minimum": 1
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "explanation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              },
              "math": {
                "type": "array",
                "items": { "type": "string" },
                "default": []
              },
              "result": {
                "type": ["string", "null"],
                "default": null
              },
              "attach_plot_hint": {
                "type": ["boolean", "null"],
                "default": null
              }
            }
          },
          "default": []
        },
        "final_answer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "latex", "units"],
          "properties": {
            "value": {
              "type": "string",
              "default": ""
            },
            "latex": {
              "type": "string",
              "default": ""
            },
            "units": {
              "type": ["string", "null"],
              "default": null
            }
          }
        },
        "key_idea": {
          "type": ["string", "null"],
          "maxLength": 300,
          "default": null
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "plot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plot_needed", "plot_reason", "plot_specs"],
      "properties": {
        "plot_needed": {
          "type": "boolean"
        },
        "plot_reason": {
          "type": ["string", "null"],
          "maxLength": 240,
          "default": null
        },
        "plot_specs": {
          "type": "null",
          "const": null,
          "description": "In SOLVE mode, plot_specs must be null; plotting is handled by a separate worker."
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "status", "checks"],
      "properties": {
        "requested": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["not_requested", "verified", "partially_verified", "failed", "error"]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check_id", "verdict", "message", "related_step_id"],
            "properties": {
              "check_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "verdict": {
                "type": "string",
                "enum": ["pass", "warn", "fail"]
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "related_step_id": {
                "type": ["integer", "null"],
                "minimum": 1,
                "default": null
              }
            }
          },
          "default": []
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "timestamps", "latency_ms", "fingerprint", "cache", "debug"],
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["ollama", "openai", "other"]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "timestamps": {
          "type": "object",
          "additionalProperties": false,
          "required": ["started_at", "completed_at"],
          "properties": {
            "started_at": {
              "type": ["string", "null"],
              "format": "date-time",
              "default": null
            },
            "completed_at": {
              "type": ["string", "null"],
              "format": "date-time",
              "default": null
            }
          }
        },
        "latency_ms": {
          "type": ["integer", "null"],
          "minimum": 0,
          "default": null
        },
        "fingerprint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["normalized_sha256"],
          "properties": {
            "normalized_sha256": {
              "type": "string",
              "default": ""
            }
          }
        },
        "cache": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hit", "type", "source_question_id"],
          "properties": {
            "hit": { "type": "boolean", "default": false },
            "type": { "type": "string", "enum": ["none", "exact", "semantic"], "default": "none" },
            "source_question_id": { "type": ["string", "null"], "default": null }
          }
        },
        "debug": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prompt_id", "schema_valid", "fallback_used", "validation_errors"],
          "properties": {
            "prompt_id": {
              "type": "string",
              "const": "solve_standard_moderate_v2"
            },
            "schema_valid": {
              "type": "boolean"
            },
            "fallback_used": {
              "type": "boolean",
              "default": false
            },
            "validation_errors": {
              "type": "array",
              "items": { "type": "string" },
              "default": []
            }
          }
        }
      }
    }
  },

  "allOf": [
    {
      "if": {
        "properties": { "solution": { "properties": { "status": { "const": "ok" } } } },
        "required": ["solution"]
      },
      "then": {
        "properties": {
          "solution": {
            "properties": {
              "steps": { "minItems": 4 },
              "final_answer": {
                "properties": {
                  "value": { "minLength": 1 },
                  "latex": { "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "solution": { "properties": { "status": { "const": "needs_clarification" } } } },
        "required": ["solution"]
      },
      "then": {
        "properties": {
          "solution": {
            "properties": {
              "steps": { "maxItems": 0 }
            }
          },
          "verification": {
            "properties": {
              "requested": { "const": false },
              "status": { "const": "not_requested" },
              "checks": { "maxItems": 0 }
            }
          },
          "plot": {
            "properties": {
              "plot_needed": { "const": false },
              "plot_reason": { "const": null }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "verification": { "properties": { "requested": { "const": false } } } },
        "required": ["verification"]
      },
      "then": {
        "properties": {
          "verification": {
            "properties": {
              "status": { "const": "not_requested" },
              "checks": { "maxItems": 0 }
            }
          }
        }
      }
    }
  ]
}
