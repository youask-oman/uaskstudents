{
  "name": "solve_final_answer_v1",
  "schema": {
    "$defs": {
      "classification": {
        "additionalProperties": false,
        "properties": {
          "difficulty": {
            "enum": [
              "easy",
              "medium",
              "hard"
            ],
            "type": "string"
          },
          "domain": {
            "enum": [
              "arithmetic",
              "pre_algebra",
              "algebra",
              "geometry",
              "trigonometry",
              "precalculus",
              "calculus",
              "linear_algebra",
              "analysis",
              "number_theory",
              "discrete_math",
              "discrete",
              "probability",
              "statistics",
              "optimization",
              "differential_equations",
              "dynamical_systems",
              "numerical_analysis",
              "abstract_algebra",
              "numerical_methods",
              "complex_analysis",
              "topology",
              "applied_math",
              "other"
            ],
            "type": "string"
          },
          "grade_band": {
            "enum": [
              "grades_6_8",
              "grades_9_10",
              "grades_11_12",
              "college_intro",
              "undergraduate_lower",
              "undergraduate_upper",
              "graduate"
            ],
            "type": "string"
          },
          "topic": {
            "default": "",
            "maxLength": 4000,
            "type": "string"
          }
        },
        "required": [
          "grade_band",
          "domain",
          "difficulty"
        ],
        "type": "object"
      },
      "debug": {
        "additionalProperties": false,
        "default": null,
        "properties": {
          "finish_reason": {
            "maxLength": 100,
            "type": [
              "string",
              "null"
            ]
          },
          "input_tokens": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "latency_ms_total": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "model": {
            "maxLength": 200,
            "type": [
              "string",
              "null"
            ]
          },
          "output_tokens": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "provider": {
            "maxLength": 100,
            "type": [
              "string",
              "null"
            ]
          },
          "request_id": {
            "maxLength": 200,
            "type": [
              "string",
              "null"
            ]
          },
          "total_tokens": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "truncated": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "request_id",
          "model",
          "provider",
          "input_tokens",
          "output_tokens",
          "total_tokens",
          "latency_ms_total",
          "finish_reason",
          "truncated"
        ],
        "type": [
          "object",
          "null"
        ]
      },
      "final_answer": {
        "additionalProperties": false,
        "properties": {
          "answer_latex": {
            "maxLength": 20000,
            "type": [
              "string",
              "null"
            ]
          },
          "answer_text": {
            "maxLength": 20000,
            "minLength": 1,
            "type": "string"
          },
          "units": {
            "maxLength": 2000,
            "type": [
              "string",
              "null"
            ]
          },
          "values": {
            "default": [],
            "items": {
              "$ref": "#/$defs/value_item"
            },
            "maxItems": 20,
            "minItems": 0,
            "type": "array"
          }
        },
        "required": [
          "answer_text",
          "answer_latex",
          "values",
          "units"
        ],
        "type": "object"
      },
      "problem": {
        "additionalProperties": false,
        "properties": {
          "detected_tasks": {
            "items": {
              "enum": [
                "solve",
                "simplify",
                "factor",
                "expand",
                "evaluate",
                "equation",
                "inequality",
                "system",
                "word_problem",
                "geometry",
                "trigonometry",
                "calculus",
                "probability",
                "statistics",
                "linear_algebra",
                "discrete_math",
                "proof",
                "graph",
                "plot",
                "other"
              ],
              "type": "string"
            },
            "maxItems": 6,
            "minItems": 1,
            "type": "array"
          },
          "language": {
            "additionalProperties": false,
            "default": null,
            "properties": {
              "response_language": {
                "maxLength": 32,
                "minLength": 2,
                "type": "string"
              },
              "user_language": {
                "maxLength": 32,
                "minLength": 2,
                "type": "string"
              }
            },
            "required": [
              "user_language",
              "response_language"
            ],
            "type": [
              "object",
              "null"
            ]
          },
          "normalized_text": {
            "maxLength": 50000,
            "minLength": 1,
            "type": "string"
          },
          "original_text": {
            "maxLength": 50000,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "original_text",
          "normalized_text",
          "detected_tasks"
        ],
        "type": "object"
      },
      "quality": {
        "additionalProperties": false,
        "properties": {
          "common_mistakes": {
            "default": [],
            "items": {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 3,
            "minItems": 0,
            "type": "array"
          },
          "confidence": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          }
        },
        "required": [
          "confidence",
          "common_mistakes"
        ],
        "type": "object"
      },
      "refusal": {
        "additionalProperties": false,
        "properties": {
          "is_refusal": {
            "type": "boolean"
          },
          "reason": {
            "maxLength": 4000,
            "type": [
              "string",
              "null"
            ]
          },
          "safe_alternative": {
            "maxLength": 4000,
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "is_refusal",
          "reason",
          "safe_alternative"
        ],
        "type": "object"
      },
      "step": {
        "additionalProperties": false,
        "properties": {
          "explanation": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "index": {
            "maximum": 2,
            "minimum": 1,
            "type": "integer"
          },
          "math_latex": {
            "default": [],
            "items": {
              "maxLength": 20000,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 6,
            "minItems": 0,
            "type": "array"
          },
          "title": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "index",
          "title",
          "explanation",
          "math_latex"
        ],
        "type": "object"
      },
      "value_item": {
        "additionalProperties": false,
        "properties": {
          "label": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "value": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean",
              "null"
            ]
          },
          "value_latex": {
            "maxLength": 20000,
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "label",
          "value",
          "value_latex"
        ],
        "type": "object"
      }
    },
    "$id": "https://youask.ai/schemas/solve_final_answer_v1.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Strict schema for concise tutoring output focused on the final answer, with up to 2 optional steps.",
    "properties": {
      "_raw_llm_output": {
        "maxLength": 200000,
        "type": [
          "string",
          "null"
        ]
      },
      "classification": {
        "$ref": "#/$defs/classification"
      },
      "debug": {
        "$ref": "#/$defs/debug"
      },
      "final_answer": {
        "$ref": "#/$defs/final_answer"
      },
      "problem": {
        "$ref": "#/$defs/problem"
      },
      "quality": {
        "$ref": "#/$defs/quality"
      },
      "refusal": {
        "$ref": "#/$defs/refusal"
      },
      "schema_version": {
        "enum": [
          "v1"
        ],
        "type": "string"
      },
      "steps": {
        "default": [],
        "items": {
          "$ref": "#/$defs/step"
        },
        "maxItems": 2,
        "minItems": 0,
        "type": "array"
      }
    },
    "required": [
      "schema_version",
      "refusal",
      "problem",
      "classification",
      "steps",
      "final_answer",
      "quality"
    ],
    "title": "YouAsk Solver Output Schema (Final Answer Only)",
    "type": "object"
  },
  "strict": false
}