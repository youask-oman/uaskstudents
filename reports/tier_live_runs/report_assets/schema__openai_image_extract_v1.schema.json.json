{
  "name": "openai_image_extract_v1",
  "schema": {
    "$defs": {
      "bbox_norm": {
        "description": "[x1,y1,x2,y2] normalized to page dimensions",
        "items": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "maxItems": 4,
        "minItems": 4,
        "type": "array"
      },
      "figure": {
        "additionalProperties": false,
        "properties": {
          "bbox": {
            "$ref": "#/$defs/bbox_norm"
          },
          "caption": {
            "maxLength": 2000,
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "maximum": 1,
            "minimum": 0,
            "type": [
              "number",
              "null"
            ]
          },
          "figure_id": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "geometry": {
            "additionalProperties": false,
            "properties": {
              "labeled_angles": {
                "items": {
                  "maxLength": 40,
                  "type": "string"
                },
                "maxItems": 50,
                "type": "array"
              },
              "labeled_points": {
                "items": {
                  "maxLength": 40,
                  "type": "string"
                },
                "maxItems": 50,
                "type": "array"
              },
              "labeled_segments": {
                "items": {
                  "maxLength": 40,
                  "type": "string"
                },
                "maxItems": 50,
                "type": "array"
              },
              "notes": {
                "maxLength": 1200,
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "labeled_points",
              "labeled_segments",
              "labeled_angles",
              "notes"
            ],
            "type": [
              "object",
              "null"
            ]
          },
          "graph": {
            "additionalProperties": false,
            "properties": {
              "plotted_description": {
                "description": "Describe what is plotted without guessing formulas if unclear.",
                "maxLength": 1200,
                "type": [
                  "string",
                  "null"
                ]
              },
              "ticks": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "axis": {
                      "enum": [
                        "x",
                        "y"
                      ],
                      "type": "string"
                    },
                    "label": {
                      "maxLength": 40,
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "value": {
                      "type": [
                        "number",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "axis",
                    "value",
                    "label"
                  ],
                  "type": "object"
                },
                "maxItems": 60,
                "minItems": 0,
                "type": "array"
              },
              "x_label": {
                "maxLength": 80,
                "type": [
                  "string",
                  "null"
                ]
              },
              "x_range": {
                "items": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              },
              "y_label": {
                "maxLength": 80,
                "type": [
                  "string",
                  "null"
                ]
              },
              "y_range": {
                "items": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              }
            },
            "required": [
              "x_label",
              "y_label",
              "x_range",
              "y_range",
              "ticks",
              "plotted_description"
            ],
            "type": [
              "object",
              "null"
            ]
          },
          "kind": {
            "enum": [
              "graph",
              "geometry",
              "table",
              "diagram",
              "unknown"
            ],
            "type": "string"
          },
          "page_index": {
            "maximum": 1999,
            "minimum": 0,
            "type": "integer"
          },
          "table": {
            "additionalProperties": false,
            "properties": {
              "rows": {
                "items": {
                  "items": {
                    "maxLength": 200,
                    "type": "string"
                  },
                  "maxItems": 40,
                  "minItems": 0,
                  "type": "array"
                },
                "maxItems": 120,
                "minItems": 0,
                "type": "array"
              }
            },
            "required": [
              "rows"
            ],
            "type": [
              "object",
              "null"
            ]
          }
        },
        "required": [
          "figure_id",
          "page_index",
          "kind",
          "bbox",
          "caption",
          "confidence",
          "graph",
          "geometry",
          "table"
        ],
        "type": "object"
      },
      "latex_no_delims": {
        "maxLength": 6000,
        "pattern": "^(?!.*\\$)(?!.*\\\\\\[)(?!.*\\\\\\])(?!.*\\\\\\()(?!.*\\\\\\)).*",
        "type": "string"
      },
      "question": {
        "additionalProperties": false,
        "properties": {
          "answer_choices": {
            "description": "MCQ options if present. Keep order.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "confidence": {
                  "maximum": 1,
                  "minimum": 0,
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "label": {
                  "description": "e.g., 'A', 'B', 'C', 'D'.",
                  "maxLength": 10,
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "latex": {
                  "$ref": "#/$defs/latex_no_delims"
                },
                "text": {
                  "maxLength": 1200,
                  "minLength": 0,
                  "type": "string"
                }
              },
              "required": [
                "label",
                "text",
                "latex",
                "confidence"
              ],
              "type": "object"
            },
            "maxItems": 12,
            "minItems": 0,
            "type": "array"
          },
          "bbox": {
            "$ref": "#/$defs/bbox_norm"
          },
          "confidence": {
            "maximum": 1,
            "minimum": 0,
            "type": [
              "number",
              "null"
            ]
          },
          "figure_refs": {
            "description": "IDs of referenced figures from figures[].",
            "items": {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 10,
            "minItems": 0,
            "type": "array"
          },
          "page_index": {
            "maximum": 1999,
            "minimum": 0,
            "type": "integer"
          },
          "question_id": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "question_latex": {
            "$ref": "#/$defs/latex_no_delims"
          },
          "question_number": {
            "description": "e.g., '1', '2', 'Q3'. null if none visible.",
            "maxLength": 20,
            "type": [
              "string",
              "null"
            ]
          },
          "question_text": {
            "maxLength": 8000,
            "minLength": 0,
            "type": "string"
          },
          "subparts": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "bbox": {
                  "$ref": "#/$defs/bbox_norm"
                },
                "confidence": {
                  "maximum": 1,
                  "minimum": 0,
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "label": {
                  "description": "e.g., '(a)', '(i)'. null if not applicable.",
                  "maxLength": 20,
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "latex": {
                  "$ref": "#/$defs/latex_no_delims"
                },
                "text": {
                  "maxLength": 4000,
                  "minLength": 0,
                  "type": "string"
                }
              },
              "required": [
                "label",
                "text",
                "latex",
                "bbox",
                "confidence"
              ],
              "type": "object"
            },
            "maxItems": 20,
            "minItems": 0,
            "type": "array"
          }
        },
        "required": [
          "question_id",
          "page_index",
          "bbox",
          "question_number",
          "question_text",
          "question_latex",
          "subparts",
          "answer_choices",
          "figure_refs",
          "confidence"
        ],
        "type": "object"
      },
      "segment": {
        "additionalProperties": false,
        "properties": {
          "bbox": {
            "$ref": "#/$defs/bbox_norm"
          },
          "confidence": {
            "maximum": 1,
            "minimum": 0,
            "type": [
              "number",
              "null"
            ]
          },
          "kind": {
            "enum": [
              "title",
              "instruction",
              "question_text",
              "equation",
              "table",
              "figure_caption",
              "answer_choices",
              "other"
            ],
            "type": "string"
          },
          "latex": {
            "$ref": "#/$defs/latex_no_delims",
            "description": "Same content as text but with mathematical parts rendered in delimiter-free TeX."
          },
          "notes": {
            "description": "Uncertainty markers like [illegible] or [uncertain]. Empty string if none.",
            "maxLength": 300,
            "minLength": 0,
            "type": "string"
          },
          "page_index": {
            "maximum": 1999,
            "minimum": 0,
            "type": "integer"
          },
          "segment_id": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "text": {
            "description": "Plain transcription preserving line breaks where possible.",
            "maxLength": 6000,
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "segment_id",
          "page_index",
          "kind",
          "bbox",
          "text",
          "latex",
          "confidence",
          "notes"
        ],
        "type": "object"
      }
    },
    "$id": "https://uask.ai/schemas/image_extract_v1.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "figures": {
        "items": {
          "$ref": "#/$defs/figure"
        },
        "maxItems": 300,
        "minItems": 0,
        "type": "array"
      },
      "needs_human_review": {
        "type": "boolean"
      },
      "pages": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "height_px": {
              "maximum": 20000,
              "minimum": 1,
              "type": [
                "integer",
                "null"
              ]
            },
            "page_index": {
              "maximum": 1999,
              "minimum": 0,
              "type": "integer"
            },
            "rotation_degrees": {
              "enum": [
                0,
                90,
                180,
                270
              ],
              "type": "integer"
            },
            "segments": {
              "items": {
                "$ref": "#/$defs/segment"
              },
              "maxItems": 600,
              "minItems": 0,
              "type": "array"
            },
            "width_px": {
              "maximum": 20000,
              "minimum": 1,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "page_index",
            "width_px",
            "height_px",
            "rotation_degrees",
            "segments"
          ],
          "type": "object"
        },
        "maxItems": 200,
        "minItems": 1,
        "type": "array"
      },
      "questions": {
        "items": {
          "$ref": "#/$defs/question"
        },
        "maxItems": 300,
        "minItems": 0,
        "type": "array"
      },
      "request_id": {
        "maxLength": 120,
        "minLength": 1,
        "type": "string"
      },
      "schema_version": {
        "const": "image_extract_v1",
        "type": "string"
      },
      "source": {
        "additionalProperties": false,
        "properties": {
          "file_name": {
            "maxLength": 260,
            "type": [
              "string",
              "null"
            ]
          },
          "page_count": {
            "maximum": 200,
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "source_type": {
            "enum": [
              "image",
              "pdf"
            ],
            "type": "string"
          }
        },
        "required": [
          "source_type",
          "file_name",
          "page_count"
        ],
        "type": "object"
      },
      "usage": {
        "additionalProperties": false,
        "properties": {
          "model": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "provider": {
            "enum": [
              "pix2txt",
              "qwen",
              "openai"
            ],
            "type": "string"
          },
          "tokens_in": {
            "maximum": 2000000,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "tokens_out": {
            "maximum": 2000000,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "provider",
          "model",
          "tokens_in",
          "tokens_out"
        ],
        "type": "object"
      },
      "warnings": {
        "items": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "maxItems": 50,
        "minItems": 0,
        "type": "array"
      }
    },
    "required": [
      "schema_version",
      "request_id",
      "source",
      "pages",
      "questions",
      "figures",
      "warnings",
      "needs_human_review",
      "usage"
    ],
    "title": "image_extract_v1",
    "type": "object"
  },
  "strict": true,
  "type": "json_schema"
}