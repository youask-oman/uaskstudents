{
  "name": "solve_free_minimal_v1",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "confidence_score": {
        "maximum": 1,
        "minimum": 0,
        "type": "number"
      },
      "final_answer": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "steps": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "explanation": {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            "index": {
              "maximum": 2,
              "minimum": 1,
              "type": "integer"
            },
            "math_latex": {
              "default": null,
              "description": "Delimiter-free TeX only (no $, $$, \\(\\), \\[\\]).",
              "maxLength": 400,
              "pattern": "^(?!.*\\$)(?!.*\\\\\\[)(?!.*\\\\\\])(?!.*\\\\\\()(?!.*\\\\\\)).+",
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "index",
            "title",
            "explanation",
            "math_latex"
          ],
          "type": "object"
        },
        "maxItems": 2,
        "minItems": 1,
        "type": "array"
      },
      "topic": {
        "maxLength": 50,
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "final_answer",
      "steps",
      "topic",
      "confidence_score"
    ],
    "title": "MinimalSolveResponse",
    "type": "object"
  },
  "strict": true,
  "type": "json_schema"
}