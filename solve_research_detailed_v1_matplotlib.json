{
  "type": "json_schema",
  "name": "solve_research_detailed_v1",
  "strict": false,
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://youask.ai/schemas/solve_research_detailed_v1.schema.json",
    "title": "YouAsk Solver Output Schema (Research Flexible Plus) (Matplotlib Recipes)",
    "description": "Production schema for math solving outputs including research-grade visualization specs. Designed to be resilient to LLM variation.\n\nUpdate: adds plot.recipe (backend-rendered) and plot.rendered (image assets). alternative_visual is now nullable.",
    "type": "object",
    "additionalProperties": true,
    "required": [
      "schema_version",
      "refusal",
      "assumptions",
      "problem",
      "classification",
      "steps",
      "final_answer",
      "visuals",
      "quality"
    ],
    "$defs": {
      "longString": {
        "type": "string",
        "maxLength": 200000
      },
      "shortString": {
        "type": "string",
        "maxLength": 2000
      },
      "latexString": {
        "type": "string",
        "maxLength": 200000
      },
      "nullableLatex": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 200000
      },
      "numOrNull": {
        "type": [
          "number",
          "null"
        ]
      },
      "step": {
        "type": "object",
        "additionalProperties": true,
        "description": "One reasoning step. Index is optional because models occasionally emit index variants; normalizers may repair.",
        "properties": {
          "index": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "index:": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "step": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200000
          },
          "math_latex": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/latexString"
            },
            "default": []
          },
          "rules_used": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/shortString"
            },
            "default": []
          },
          "plots_used": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/shortString"
            },
            "default": []
          },
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/shortString"
            },
            "default": []
          },
          "notes": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200000
          }
        },
        "required": [
          "title",
          "explanation"
        ]
      },
      "keyPoint": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "label"
        ],
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 20000
          },
          "x": {
            "$ref": "#/$defs/numOrNull"
          },
          "y": {
            "$ref": "#/$defs/numOrNull"
          },
          "z": {
            "$ref": "#/$defs/numOrNull"
          },
          "t": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200000
          }
        }
      },
      "series": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 20000
          },
          "expr_latex": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200000
          },
          "expr_text": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200000
          },
          "style_hint": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "x": {
                  "$ref": "#/$defs/numOrNull"
                },
                "y": {
                  "$ref": "#/$defs/numOrNull"
                },
                "z": {
                  "$ref": "#/$defs/numOrNull"
                },
                "t": {
                  "type": [
                    "number",
                    "string",
                    "null"
                  ]
                },
                "label": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 20000
                }
              }
            },
            "default": []
          },
          "x": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ]
            },
            "default": []
          },
          "y": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ]
            },
            "default": []
          },
          "z": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ]
            },
            "default": []
          },
          "matrix": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "default": []
          },
          "image_ref": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "data_ref": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "data_format": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "inline",
              "csv",
              "json",
              "npy",
              "npz",
              "parquet",
              "image",
              "other",
              null
            ]
          }
        }
      },
      "plot": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "kind",
          "title"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "function_2d",
              "scatter_2d",
              "parametric_2d",
              "implicit_2d",
              "contour_2d",
              "heatmap_2d",
              "vector_field_2d",
              "phase_portrait",
              "cobweb",
              "bifurcation",
              "time_series",
              "histogram",
              "bar",
              "boxplot",
              "qq_plot",
              "ecdf",
              "surface_3d",
              "scatter_3d",
              "contour_3d",
              "volume_3d",
              "image",
              "fractal",
              "network",
              "table",
              "custom"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "subtitle": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 20000
          },
          "x_label": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "y_label": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "z_label": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "domain": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "x_min": {
                "$ref": "#/$defs/numOrNull"
              },
              "x_max": {
                "$ref": "#/$defs/numOrNull"
              },
              "y_min": {
                "$ref": "#/$defs/numOrNull"
              },
              "y_max": {
                "$ref": "#/$defs/numOrNull"
              },
              "z_min": {
                "$ref": "#/$defs/numOrNull"
              },
              "z_max": {
                "$ref": "#/$defs/numOrNull"
              }
            }
          },
          "series": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "$ref": "#/$defs/series"
            },
            "default": []
          },
          "key_points": {
            "type": "array",
            "maxItems": 2000,
            "items": {
              "$ref": "#/$defs/keyPoint"
            },
            "default": []
          },
          "render_hint": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "preferred": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "plotly",
                  "matplotlib",
                  "vega_lite",
                  "chartjs",
                  "custom",
                  null
                ]
              },
              "log_x": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "log_y": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "log_z": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "aspect_ratio": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 100
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 20000
              }
            }
          },
          "recipe": {
            "description": "Instructions-only plot recipe. No dense arrays. Backend uses this to generate plots with matplotlib/numpy/sympy.",
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true,
            "properties": {
              "generator": {
                "type": "string",
                "enum": [
                  "function_2d",
                  "ode_system",
                  "phase_portrait",
                  "poincare",
                  "bifurcation_sweep",
                  "data_ref",
                  "custom"
                ]
              },
              "expr": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 200000
              },
              "symbols": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 50
                },
                "maxItems": 20,
                "default": []
              },
              "system": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 2000
              },
              "params": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": true,
                "default": null
              },
              "initial_conditions": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": true,
                "default": null
              },
              "sampling": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": true,
                "properties": {
                  "t_min": {
                    "$ref": "#/$defs/numOrNull"
                  },
                  "t_max": {
                    "$ref": "#/$defs/numOrNull"
                  },
                  "dt": {
                    "$ref": "#/$defs/numOrNull"
                  },
                  "samples": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  },
                  "discard": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "transient_periods": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "keep_periods": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  },
                  "samples_per_period": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 10
                  }
                },
                "default": null
              },
              "sweep": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": true,
                "properties": {
                  "param": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 2000
                  },
                  "min": {
                    "$ref": "#/$defs/numOrNull"
                  },
                  "max": {
                    "$ref": "#/$defs/numOrNull"
                  },
                  "steps": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 2
                  }
                },
                "default": null
              },
              "data_ref": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 2000
              }
            },
            "default": null
          },
          "rendered": {
            "description": "Filled by backend after matplotlib render. Frontend should prefer this over Plotly.",
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true,
            "properties": {
              "image_ref": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 2000
              },
              "mime": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 100
              },
              "width_px": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "height_px": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "caption": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 20000
              }
            },
            "default": null
          }
        }
      }
    },
    "properties": {
      "schema_version": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "examples": [
          "v1"
        ]
      },
      "refusal": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "is_refusal",
          "reason",
          "safe_alternative"
        ],
        "properties": {
          "is_refusal": {
            "type": "boolean"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 20000
          },
          "safe_alternative": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 20000
          }
        }
      },
      "assumptions": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 20000
        },
        "default": []
      },
      "problem": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "original_text",
          "normalized_text",
          "detected_tasks"
        ],
        "properties": {
          "original_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200000
          },
          "normalized_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200000
          },
          "language": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 40
          },
          "detected_tasks": {
            "type": "array",
            "minItems": 0,
            "maxItems": 400,
            "items": {
              "type": "string",
              "enum": [
                "solve",
                "simplify",
                "factor",
                "expand",
                "evaluate",
                "equation",
                "inequality",
                "system",
                "word_problem",
                "graph",
                "plot",
                "geometry",
                "trigonometry",
                "calculus",
                "probability",
                "statistics",
                "linear_algebra",
                "matrix_algebra",
                "diagonalization",
                "eigenvalues",
                "eigenvectors",
                "svd",
                "pca",
                "determinants",
                "rank",
                "nullspace",
                "orthogonality",
                "quadratic_forms",
                "spectral_theory",
                "numerical_linear_algebra",
                "real_analysis",
                "complex_analysis",
                "functional_analysis",
                "measure_theory",
                "topology",
                "differential_equations",
                "ode",
                "pde",
                "dynamical_systems",
                "stability_analysis",
                "bifurcation_analysis",
                "chaos",
                "fourier_analysis",
                "laplace_transform",
                "z_transform",
                "number_theory",
                "discrete_math",
                "combinatorics",
                "graph_theory",
                "logic",
                "set_theory",
                "optimization",
                "convex_optimization",
                "nonconvex_optimization",
                "linear_programming",
                "integer_programming",
                "variational_methods",
                "stochastic_processes",
                "markov_chains",
                "bayesian_inference",
                "time_series",
                "regression",
                "hypothesis_testing",
                "statistical_learning",
                "information_theory",
                "numerical_analysis",
                "approximation",
                "interpolation",
                "integration",
                "differentiation",
                "monte_carlo",
                "simulation",
                "abstract_algebra",
                "group_theory",
                "ring_theory",
                "field_theory",
                "galois_theory",
                "geometry_analytic",
                "geometry_differential",
                "tensor_calculus",
                "vector_calculus",
                "physics_math",
                "signals_systems",
                "control_theory",
                "computer_algebra",
                "proof",
                "counterexample",
                "derivation",
                "verification",
                "error_analysis",
                "data_science",
                "machine_learning_math",
                "other"
              ]
            },
            "default": []
          }
        }
      },
      "classification": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "grade_band",
          "domain",
          "topic",
          "difficulty"
        ],
        "properties": {
          "grade_band": {
            "type": "string",
            "enum": [
              "elementary",
              "middle_school",
              "high_school",
              "college_intro",
              "college_upper",
              "graduate",
              "research"
            ]
          },
          "domain": {
            "type": "string",
            "enum": [
              "arithmetic",
              "pre_algebra",
              "algebra",
              "geometry",
              "trigonometry",
              "precalculus",
              "calculus",
              "linear_algebra",
              "analysis",
              "number_theory",
              "discrete_math",
              "discrete",
              "probability",
              "statistics",
              "optimization",
              "differential_equations",
              "dynamical_systems",
              "numerical_analysis",
              "abstract_algebra",
              "topology",
              "applied_math",
              "other"
            ]
          },
          "topic": {
            "type": "string",
            "maxLength": 20000
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "very_easy",
              "easy",
              "medium",
              "hard",
              "very_hard",
              "research"
            ]
          }
        }
      },
      "steps": {
        "type": "array",
        "minItems": 0,
        "maxItems": 200,
        "items": {
          "$ref": "#/$defs/step"
        }
      },
      "final_answer": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "answer_text",
          "answer_latex",
          "values",
          "units"
        ],
        "properties": {
          "answer_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200000
          },
          "answer_latex": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200000
          },
          "values": {
            "type": "array",
            "maxItems": 5000,
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "label",
                "value",
                "value_latex"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "maxLength": 2000
                },
                "value": {
                  "description": "Flexible value container; may be scalar, object, or array.",
                  "type": [
                    "string",
                    "number",
                    "integer",
                    "boolean",
                    "null",
                    "object",
                    "array"
                  ],
                  "items": {},
                  "additionalProperties": true
                },
                "value_latex": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 200000
                }
              }
            },
            "default": []
          },
          "units": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          }
        }
      },
      "visuals": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "should_visualize",
          "decision_reason",
          "plots",
          "alternative_visual"
        ],
        "properties": {
          "should_visualize": {
            "type": "boolean"
          },
          "decision_reason": {
            "type": "string",
            "maxLength": 200000
          },
          "plots": {
            "type": "array",
            "minItems": 0,
            "maxItems": 20,
            "items": {
              "$ref": "#/$defs/plot"
            },
            "default": []
          },
          "alternative_visual": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true,
            "required": [
              "kind",
              "description",
              "data"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "maxLength": 2000
              },
              "description": {
                "type": "string",
                "maxLength": 200000
              },
              "data": {
                "type": "array",
                "items": {},
                "default": []
              }
            },
            "default": null,
            "description": "Optional alternative visual description. Prefer leaving null when not needed."
          }
        }
      },
      "quality": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "confidence",
          "common_mistakes"
        ],
        "properties": {
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "common_mistakes": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000
            },
            "default": []
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20000
            },
            "default": []
          }
        }
      },
      "debug": {
        "type": "object",
        "additionalProperties": true,
        "description": "Optional runtime metadata (provider/model/tier/request ids).",
        "properties": {
          "tier": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 50
          },
          "mode": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 50
          },
          "llm_provider": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "model": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "latency_ms": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      },
      "_raw_llm_output": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 5000000
      }
    }
  }
}