native_visual":null},{"title":"Optional: Fej\\'er sums \\sigma_N vs S_N for N=50","x_min":-3.141592653589793,"x_max":3.141592653589793,"y_min":-1.5,"y_max":1.5,"plot_kind":"cartesian_2d","x_scale":"linear","y_scale":"linear","series":[{"kind":"grid2d_ref","label":"S_N:n=50","expr_latex":null,"points":[],"data_ref":"S_N:n=50","color":"green","line_width":1.2,"line_style":"solid","marker_style":"none"},{"kind":"grid2d_ref","label":"sigma_N:n=50","expr_latex":null,"points":[],"data_ref":"sigma_N:n=50","color":"magenta","line_width":1.2,"line_style":"dashed","marker_style":"none"}],"key_points":[],"alternative_visual":null}],"alternative_visual":{"kind":"none","description":"Plots saved as artifacts for backend rendering.","data":[]},"quality":{"confidence":0.9,"common_mistakes":["Forgetting that only odd harmonics are present","Measuring overshoot with neighborhoods that are too large so apparent height decreases","Using too coarse a grid causing aliasing near discontinuities","Fitting slope on too small n-range leading to biased decay estimate","Confusing coefficient index n with Fourier mode number when only odd modes appear"]},"experiment":{"pde":null,"discretization":{"scheme":"finite_difference_5pt","order":2,"stencil":"not_applicable","scaling_convention":"A_is_L_over_h2__b_is_g"},"solver":{"method":"cg","rtol":1e-10,"atol":1e-12,"maxiter":10000,"residual_reference":"b"},"eigens":{"method":"direct_small_n","which":"max","tol":1e-8},"preconditioner":{"enabled":false,"method":"none"},"runs":[{"n":5,"note":"Compute S_N and sigma_N for N=5"},{"n":15,"note":"Compute S_N and sigma_N for N=15"},{"n":50,"note":"Compute S_N and sigma_N for N=50"},{"n":200,"note":"Compute S_N and sigma_N for N=200"},{"n":400,"note":"Extra N for convergence sweep"}]},"artifacts":[{"key":"f_grid:M=2000","kind":"curve","shape":"(M,)","data_ref":"f_grid:M=2000","description":"Sampled square wave values on M=2000 grid","units":null},{"key":"S_N:n=5","kind":"curve","shape":"(M,)","data_ref":"S_N