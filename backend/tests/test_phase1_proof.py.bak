        session.add(SystemConfig(key="tokens.text.input_max", value="1000"))
        session.add(SystemConfig(key="tokens.text.input_max_chars", value="10000"))
        session.add(SystemConfig(key="tokens.text.output_max_minimal_solve", value="1000"))
        session.add(SystemConfig(key="tokens.text.output_max_detailed_solve", value="2000"))
        # Add minimal required keys to avoid warnings/errors
        for key in [
            "tokens.text.output_max_minimal_study", "tokens.text.output_max_detailed_study",
            "tokens.text.steps_minimal_solve", "tokens.text.steps_detailed_solve",
