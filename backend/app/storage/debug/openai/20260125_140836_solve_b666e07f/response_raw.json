es\": [\n      {\n        \"label\": \"x\",\n        \"value\": 7,\n        \"value_latex\": \"7\"\n      }\n    ],\n    \"units\": \"\"\n  },\n  \"visuals\": {\n    \"should_visualize\": false,\n    \"decision_reason\": \"This is a simple linear equation that does not require a plot or diagram.\",\n    \"plots\": []\n  ,\n    \"alternative_visual\": {\n      \"kind\": \"none\",\n      \"description\": \"\",\n      \"data\": []\n    }\n  },\n  \"quality\": {\n    \"confidence\": 0.96,\n    \"common_mistakes\": [\n      \"Forgetting to distribute the 3 and writing 3x - 2 instead of 3x - 6.\",\n      \"Adding or subtracting the wrong sign when moving constants.\",\n      \"Dividing by the wrong number or dividing the wrong side.\"\n    ]\n  }\n}",
