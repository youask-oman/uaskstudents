{
  "type": "json_schema",
  "name": "youask_plot_trigger_v1",
  "strict": true,
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "YouAsk Plot Trigger v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "plot_needed",
      "plot_type",
      "variables",
      "ranges",
      "reason",
      "series_plan",
      "key_points"
    ],
    "properties": {
      "plot_needed": {
        "type": "boolean"
      },
      "plot_type": {
        "type": [
          "string",
          "null"
        ],
        "enum": [
          "function",
          "implicit",
          "region",
          "points",
          "histogram",
          "boxplot",
          "unknown",
          null
        ]
      },
      "variables": {
        "type": "array",
        "minItems": 0,
        "maxItems": 3,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8
        }
      },
      "ranges": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "required": [
          "x",
          "y"
        ],
        "properties": {
          "x": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "min",
              "max"
            ],
            "properties": {
              "min": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "max": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          },
          "y": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "min",
              "max"
            ],
            "properties": {
              "min": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "max": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        }
      },
      "reason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "series_plan": {
        "type": "array",
        "minItems": 0,
        "maxItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "expr_latex"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "expr_latex": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "description": "Delimiter-free TeX only (no $, $$, \\(\\), \\[\\]).",
              "pattern": "^(?!.*\\$)(?!.*\\\\\\[)(?!.*\\\\\\])(?!.*\\\\\\()(?!.*\\\\\\)).+"
            }
          }
        }
      },
      "key_points": {
        "type": "array",
        "minItems": 0,
        "maxItems": 8,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "label"
          ],
          "properties": {
            "x": {
              "type": [
                "number",
                "null"
              ]
            },
            "y": {
              "type": [
                "number",
                "null"
              ]
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          }
        }
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "plot_needed": {
              "const": false
            }
          }
        },
        "then": {
          "properties": {
            "plot_type": {
              "type": "null"
            },
            "variables": {
              "maxItems": 0
            },
            "ranges": {
              "type": "null"
            },
            "series_plan": {
              "maxItems": 0
            },
            "key_points": {
              "maxItems": 0
            }
          }
        }
      }
    ]
  }
}