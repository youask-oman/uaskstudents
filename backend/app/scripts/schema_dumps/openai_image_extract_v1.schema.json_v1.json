{
  "type": "json_schema",
  "name": "image_extract_v1",
  "strict": true,
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://uask.ai/schemas/image_extract_v1.json",
    "title": "image_extract_v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "request_id",
      "source",
      "pages",
      "questions",
      "figures",
      "warnings",
      "needs_human_review",
      "usage"
    ],
    "properties": {
      "schema_version": {
        "type": "string",
        "const": "image_extract_v1"
      },
      "request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "source": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_type",
          "file_name",
          "page_count"
        ],
        "properties": {
          "source_type": {
            "type": "string",
            "enum": [
              "image",
              "pdf"
            ]
          },
          "file_name": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 260
          },
          "page_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 200
          }
        }
      },
      "pages": {
        "type": "array",
        "minItems": 1,
        "maxItems": 200,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "page_index",
            "width_px",
            "height_px",
            "rotation_degrees",
            "segments"
          ],
          "properties": {
            "page_index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1999
            },
            "width_px": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 20000
            },
            "height_px": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 20000
            },
            "rotation_degrees": {
              "type": "integer",
              "enum": [
                0,
                90,
                180,
                270
              ]
            },
            "segments": {
              "type": "array",
              "minItems": 0,
              "maxItems": 600,
              "items": {
                "$ref": "#/$defs/segment"
              }
            }
          }
        }
      },
      "questions": {
        "type": "array",
        "minItems": 0,
        "maxItems": 300,
        "items": {
          "$ref": "#/$defs/question"
        }
      },
      "figures": {
        "type": "array",
        "minItems": 0,
        "maxItems": 300,
        "items": {
          "$ref": "#/$defs/figure"
        }
      },
      "warnings": {
        "type": "array",
        "minItems": 0,
        "maxItems": 50,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "needs_human_review": {
        "type": "boolean"
      },
      "usage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "model",
          "tokens_in",
          "tokens_out"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "pix2txt",
              "qwen",
              "openai"
            ]
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "tokens_in": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 2000000
          },
          "tokens_out": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 2000000
          }
        }
      }
    },
    "$defs": {
      "latex_no_delims": {
        "type": "string",
        "maxLength": 6000,
        "pattern": "^(?!.*\\$)(?!.*\\\\\\[)(?!.*\\\\\\])(?!.*\\\\\\()(?!.*\\\\\\)).*"
      },
      "bbox_norm": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "description": "[x1,y1,x2,y2] normalized to page dimensions"
      },
      "segment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segment_id",
          "page_index",
          "kind",
          "bbox",
          "text",
          "latex",
          "confidence",
          "notes"
        ],
        "properties": {
          "segment_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "page_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1999
          },
          "kind": {
            "type": "string",
            "enum": [
              "title",
              "instruction",
              "question_text",
              "equation",
              "table",
              "figure_caption",
              "answer_choices",
              "other"
            ]
          },
          "bbox": {
            "$ref": "#/$defs/bbox_norm"
          },
          "text": {
            "type": "string",
            "minLength": 0,
            "maxLength": 6000,
            "description": "Plain transcription preserving line breaks where possible."
          },
          "latex": {
            "$ref": "#/$defs/latex_no_delims",
            "description": "Same content as text but with mathematical parts rendered in delimiter-free TeX."
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "notes": {
            "type": "string",
            "minLength": 0,
            "maxLength": 300,
            "description": "Uncertainty markers like [illegible] or [uncertain]. Empty string if none."
          }
        }
      },
      "question": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id",
          "page_index",
          "bbox",
          "question_number",
          "question_text",
          "question_latex",
          "subparts",
          "answer_choices",
          "figure_refs",
          "confidence"
        ],
        "properties": {
          "question_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "page_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1999
          },
          "bbox": {
            "$ref": "#/$defs/bbox_norm"
          },
          "question_number": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 20,
            "description": "e.g., '1', '2', 'Q3'. null if none visible."
          },
          "question_text": {
            "type": "string",
            "minLength": 0,
            "maxLength": 8000
          },
          "question_latex": {
            "$ref": "#/$defs/latex_no_delims"
          },
          "subparts": {
            "type": "array",
            "minItems": 0,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "text",
                "latex",
                "bbox",
                "confidence"
              ],
              "properties": {
                "label": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 20,
                  "description": "e.g., '(a)', '(i)'. null if not applicable."
                },
                "text": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 4000
                },
                "latex": {
                  "$ref": "#/$defs/latex_no_delims"
                },
                "bbox": {
                  "$ref": "#/$defs/bbox_norm"
                },
                "confidence": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          },
          "answer_choices": {
            "type": "array",
            "minItems": 0,
            "maxItems": 12,
            "description": "MCQ options if present. Keep order.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "text",
                "latex",
                "confidence"
              ],
              "properties": {
                "label": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 10,
                  "description": "e.g., 'A', 'B', 'C', 'D'."
                },
                "text": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 1200
                },
                "latex": {
                  "$ref": "#/$defs/latex_no_delims"
                },
                "confidence": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          },
          "figure_refs": {
            "type": "array",
            "minItems": 0,
            "maxItems": 10,
            "description": "IDs of referenced figures from figures[].",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "figure": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "figure_id",
          "page_index",
          "kind",
          "bbox",
          "caption",
          "confidence",
          "graph",
          "geometry",
          "table"
        ],
        "properties": {
          "figure_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "page_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1999
          },
          "kind": {
            "type": "string",
            "enum": [
              "graph",
              "geometry",
              "table",
              "diagram",
              "unknown"
            ]
          },
          "bbox": {
            "$ref": "#/$defs/bbox_norm"
          },
          "caption": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "graph": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "x_label",
              "y_label",
              "x_range",
              "y_range",
              "ticks",
              "plotted_description"
            ],
            "properties": {
              "x_label": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 80
              },
              "y_label": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 80
              },
              "x_range": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "y_range": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "ticks": {
                "type": "array",
                "minItems": 0,
                "maxItems": 60,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "axis",
                    "value",
                    "label"
                  ],
                  "properties": {
                    "axis": {
                      "type": "string",
                      "enum": [
                        "x",
                        "y"
                      ]
                    },
                    "value": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "label": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 40
                    }
                  }
                }
              },
              "plotted_description": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 1200,
                "description": "Describe what is plotted without guessing formulas if unclear."
              }
            }
          },
          "geometry": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "labeled_points",
              "labeled_segments",
              "labeled_angles",
              "notes"
            ],
            "properties": {
              "labeled_points": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "string",
                  "maxLength": 40
                }
              },
              "labeled_segments": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "string",
                  "maxLength": 40
                }
              },
              "labeled_angles": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "string",
                  "maxLength": 40
                }
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 1200
              }
            }
          },
          "table": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "rows"
            ],
            "properties": {
              "rows": {
                "type": "array",
                "minItems": 0,
                "maxItems": 120,
                "items": {
                  "type": "array",
                  "minItems": 0,
                  "maxItems": 40,
                  "items": {
                    "type": "string",
                    "maxLength": 200
                  }
                }
              }
            }
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "graph"
                }
              }
            },
            "then": {
              "required": [
                "graph"
              ],
              "properties": {
                "graph": {
                  "type": "object"
                },
                "geometry": {
                  "type": "null"
                },
                "table": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "geometry"
                }
              }
            },
            "then": {
              "required": [
                "geometry"
              ],
              "properties": {
                "geometry": {
                  "type": "object"
                },
                "graph": {
                  "type": "null"
                },
                "table": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "table"
                }
              }
            },
            "then": {
              "required": [
                "table"
              ],
              "properties": {
                "table": {
                  "type": "object"
                },
                "graph": {
                  "type": "null"
                },
                "geometry": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    }
  }
}