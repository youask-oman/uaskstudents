{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://uask.ai/schemas/minimal_solve_response.schema.json",
    "title": "MinimalSolveResponse",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "refusal",
        "assumptions",
        "problem",
        "classification",
        "steps",
        "final_answer",
        "quick_check",
        "needs_visual",
        "plot_suggestion",
        "quality"
    ],
    "properties": {
        "schema_version": {
            "type": "string",
            "const": "min_v1"
        },
        "refusal": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "is_refusal",
                "reason",
                "safe_alternative"
            ],
            "properties": {
                "is_refusal": {
                    "type": "boolean"
                },
                "reason": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "safe_alternative": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        },
        "assumptions": {
            "type": "array",
            "maxItems": 3,
            "items": {
                "type": "string"
            }
        },
        "problem": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "original_text",
                "normalized_text",
                "detected_tasks"
            ],
            "properties": {
                "original_text": {
                    "type": "string"
                },
                "normalized_text": {
                    "type": "string"
                },
                "detected_tasks": {
                    "type": "array",
                    "maxItems": 4,
                    "items": {
                        "type": "string",
                        "enum": [
                            "solve_equation",
                            "solve_inequality",
                            "simplify",
                            "factor",
                            "expand",
                            "evaluate",
                            "graph",
                            "find_intercepts",
                            "find_vertex",
                            "find_extrema",
                            "find_roots",
                            "system_solve",
                            "word_problem",
                            "geometry",
                            "trigonometry",
                            "calculus_derivative",
                            "calculus_integral",
                            "statistics",
                            "probability",
                            "sequence_series",
                            "other"
                        ]
                    }
                }
            }
        },
        "classification": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "grade_band",
                "domain",
                "topic",
                "difficulty"
            ],
            "properties": {
                "grade_band": {
                    "type": "string",
                    "enum": [
                        "K-2",
                        "3-5",
                        "6-8",
                        "9-10",
                        "11-12",
                        "college_intro",
                        "unknown"
                    ]
                },
                "domain": {
                    "type": "string",
                    "enum": [
                        "arithmetic",
                        "algebra",
                        "geometry",
                        "trigonometry",
                        "calculus",
                        "statistics",
                        "probability",
                        "discrete",
                        "mixed",
                        "unknown"
                    ]
                },
                "topic": {
                    "type": "string"
                },
                "difficulty": {
                    "type": "string",
                    "enum": [
                        "easy",
                        "standard",
                        "challenging",
                        "unknown"
                    ]
                }
            }
        },
        "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "index",
                    "title",
                    "explanation",
                    "math_latex"
                ],
                "properties": {
                    "index": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "title": {
                        "type": "string"
                    },
                    "explanation": {
                        "type": "string",
                        "maxLength": 240
                    },
                    "math_latex": {
                        "type": "string"
                    },
                    "checkpoint": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "question",
                            "answer"
                        ],
                        "properties": {
                            "question": {
                                "type": "string",
                                "maxLength": 150
                            },
                            "answer": {
                                "type": "string",
                                "maxLength": 100
                            }
                        }
                    }
                }
            }
        },
        "final_answer": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "answer_text",
                "answer_latex",
                "units"
            ],
            "properties": {
                "answer_text": {
                    "type": "string",
                    "maxLength": 200
                },
                "answer_latex": {
                    "type": "string"
                },
                "units": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        },
        "quick_check": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "method",
                "work_latex",
                "conclusion"
            ],
            "properties": {
                "method": {
                    "type": "string"
                },
                "work_latex": {
                    "type": "string",
                    "maxLength": 400
                },
                "conclusion": {
                    "type": "string"
                }
            }
        },
        "needs_visual": {
            "type": "boolean"
        },
        "plot_suggestion": {
            "type": [
                "object",
                "null"
            ],
            "additionalProperties": false,
            "required": [
                "expression_latex",
                "x_min",
                "x_max",
                "y_min",
                "y_max",
                "key_points",
                "notes"
            ],
            "properties": {
                "expression_latex": {
                    "type": "string"
                },
                "x_min": {
                    "type": "number"
                },
                "x_max": {
                    "type": "number"
                },
                "y_min": {
                    "type": "number"
                },
                "y_max": {
                    "type": "number"
                },
                "key_points": {
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "x",
                            "y",
                            "label"
                        ],
                        "properties": {
                            "x": {
                                "type": "number"
                            },
                            "y": {
                                "type": "number"
                            },
                            "label": {
                                "type": "string"
                            }
                        }
                    }
                },
                "notes": {
                    "type": "string"
                }
            }
        },
        "quality": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "confidence",
                "common_mistakes",
                "next_practice"
            ],
            "properties": {
                "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "common_mistakes": {
                    "type": "array",
                    "maxItems": 1,
                    "items": {
                        "type": "string"
                    }
                },
                "next_practice": {
                    "type": "array",
                    "maxItems": 1,
                    "items": {
                        "type": "string"
                    }
                }
            }
        }
    }
}
