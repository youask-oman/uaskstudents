{
    "name": "MinimalSolveResponse",
    "strict": true,
    "schema": {
        "type": "object",
        "properties": {
            "final_answer": {
                "type": "string",
                "maxLength": 200
            },
            "steps": {
                "type": "array",
                "maxItems": 2,
                "items": {
                    "type": "string",
                    "maxLength": 200
                }
            },
            "topic": {
                "type": "string",
                "maxLength": 50
            },
            "confidence_score": {
                "type": "number"
            }
        },
        "required": [
            "final_answer",
            "steps",
            "topic",
            "confidence_score"
        ],
        "additionalProperties": false
    }
}
