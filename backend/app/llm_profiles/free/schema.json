{
    "name": "MinimalSolveResponse",
    "strict": true,
    "schema": {
        "type": "object",
        "properties": {
            "final_answer": {
                "type": "string",
                "maxLength": 200
            },
            "steps": {
                "type": "array",
                "maxItems": 2,
                "items": {
                    "type": "object",
                    "properties": {
                        "index": {
                            "type": "integer"
                        },
                        "title": {
                            "type": "string",
                            "maxLength": 100
                        },
                        "explanation": {
                            "type": "string",
                            "maxLength": 300
                        },
                        "math_latex": {
                            "type": "string",
                            "maxLength": 400
                        }
                    },
                    "required": [
                        "index",
                        "title",
                        "explanation"
                    ],
                    "additionalProperties": false
                }
            },
            "topic": {
                "type": "string",
                "maxLength": 50
            },
            "confidence_score": {
                "type": "number"
            }
        },
        "required": [
            "final_answer",
            "steps",
            "topic",
            "confidence_score"
        ],
        "additionalProperties": false
    }
}
