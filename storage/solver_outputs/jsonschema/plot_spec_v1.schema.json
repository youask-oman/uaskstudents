{
    "type": "json_schema",
    "name": "plot_spec_v1",
    "strict": true,
    "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "YouAsk Plot Spec v1",
        "type": "object",
        "additionalProperties": false,
        "properties": {
            "plot_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
            },
            "plotly_json": {
                "type": "object",
                "description": "Plotly JSON object containing at least keys 'data' and 'layout'.",
                "additionalProperties": true
            },
            "attach_to_step_id": {
                "type": [
                    "integer",
                    "null"
                ],
                "minimum": 1,
                "default": null
            }
        },
        "required": [
            "plot_id",
            "plotly_json",
            "attach_to_step_id"
        ]
    }
}