{
    "type": "json_schema",
    "name": "solve_free_minimal_v1",
    "strict": true,
    "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "MinimalSolveResponse",
        "type": "object",
        "additionalProperties": false,
        "properties": {
            "final_answer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
            },
            "steps": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "index": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 2
                        },
                        "title": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100
                        },
                        "explanation": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 300
                        },
                        "math_latex": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "default": null,
                            "maxLength": 400,
                            "description": "Delimiter-free TeX only (no $, $$, \\(\\), \\[\\]).",
                            "pattern": "^(?!.*\\$)(?!.*\\\\\\[)(?!.*\\\\\\])(?!.*\\\\\\()(?!.*\\\\\\)).+"
                        }
                    },
                    "required": [
                        "index",
                        "title",
                        "explanation",
                        "math_latex"
                    ]
                }
            },
            "topic": {
                "type": "string",
                "minLength": 1,
                "maxLength": 50
            },
            "confidence_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
            }
        },
        "required": [
            "final_answer",
            "steps",
            "topic",
            "confidence_score"
        ]
    }
}