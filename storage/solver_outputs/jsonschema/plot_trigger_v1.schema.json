{
    "type": "json_schema",
    "name": "plot_trigger_v1",
    "strict": true,
    "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "YouAsk Plot Trigger v1",
        "type": "object",
        "additionalProperties": false,
        "properties": {
            "plot_needed": {
                "type": "boolean"
            },
            "plot_type": {
                "type": [
                    "string",
                    "null"
                ],
                "enum": [
                    "function",
                    "implicit",
                    "region",
                    "points",
                    "histogram",
                    "boxplot",
                    "unknown",
                    null
                ]
            },
            "variables": {
                "type": "array",
                "minItems": 0,
                "maxItems": 3,
                "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8
                }
            },
            "ranges": {
                "type": [
                    "object",
                    "null"
                ],
                "additionalProperties": false,
                "properties": {
                    "x": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "min": {
                                "type": [
                                    "number",
                                    "null"
                                ]
                            },
                            "max": {
                                "type": [
                                    "number",
                                    "null"
                                ]
                            }
                        },
                        "required": [
                            "min",
                            "max"
                        ]
                    },
                    "y": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "min": {
                                "type": [
                                    "number",
                                    "null"
                                ]
                            },
                            "max": {
                                "type": [
                                    "number",
                                    "null"
                                ]
                            }
                        },
                        "required": [
                            "min",
                            "max"
                        ]
                    }
                },
                "required": [
                    "x",
                    "y"
                ]
            },
            "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
            },
            "series_plan": {
                "type": "array",
                "minItems": 0,
                "maxItems": 3,
                "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "label": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 40
                        },
                        "expr_latex": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 240,
                            "description": "Delimiter-free TeX only (no $, $$, \\(\\), \\[\\]).",
                            "pattern": "^(?!.*\\$)(?!.*\\\\\\[)(?!.*\\\\\\])(?!.*\\\\\\()(?!.*\\\\\\)).+"
                        }
                    },
                    "required": [
                        "label",
                        "expr_latex"
                    ]
                }
            },
            "key_points": {
                "type": "array",
                "minItems": 0,
                "maxItems": 8,
                "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "x": {
                            "type": [
                                "number",
                                "null"
                            ]
                        },
                        "y": {
                            "type": [
                                "number",
                                "null"
                            ]
                        },
                        "label": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 40
                        }
                    },
                    "required": [
                        "x",
                        "y",
                        "label"
                    ]
                }
            }
        },
        "required": [
            "plot_needed",
            "plot_type",
            "variables",
            "ranges",
            "reason",
            "series_plan",
            "key_points"
        ]
    }
}