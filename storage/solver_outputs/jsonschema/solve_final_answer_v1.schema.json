{
    "name": "solve_final_answer_v1",
    "strict": true,
    "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://youask.ai/schemas/solve_final_answer_v1.schema.json",
        "title": "YouAsk Solver Output Schema (Final Answer Only)",
        "description": "Strict schema for concise tutoring output focused on the final answer, with up to 2 optional steps.",
        "type": "object",
        "additionalProperties": false,
        "required": [
            "schema_version",
            "refusal",
            "problem",
            "classification",
            "steps",
            "final_answer",
            "quality"
        ],
        "properties": {
            "schema_version": {
                "type": "string",
                "enum": [
                    "v1"
                ]
            },
            "refusal": {
                "$ref": "#/$defs/refusal"
            },
            "problem": {
                "$ref": "#/$defs/problem"
            },
            "classification": {
                "$ref": "#/$defs/classification"
            },
            "steps": {
                "type": "array",
                "minItems": 0,
                "maxItems": 2,
                "items": {
                    "$ref": "#/$defs/step"
                },
                "default": []
            },
            "final_answer": {
                "$ref": "#/$defs/final_answer"
            },
            "quality": {
                "$ref": "#/$defs/quality"
            },
            "debug": {
                "$ref": "#/$defs/debug"
            },
            "_raw_llm_output": {
                "type": [
                    "string",
                    "null"
                ],
                "maxLength": 200000
            }
        },
        "$defs": {
            "refusal": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "is_refusal",
                    "reason",
                    "safe_alternative"
                ],
                "properties": {
                    "is_refusal": {
                        "type": "boolean"
                    },
                    "reason": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 4000
                    },
                    "safe_alternative": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 4000
                    }
                }
            },
            "problem": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "original_text",
                    "normalized_text",
                    "detected_tasks"
                ],
                "properties": {
                    "original_text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 50000
                    },
                    "normalized_text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 50000
                    },
                    "language": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "additionalProperties": false,
                        "required": [
                            "user_language",
                            "response_language"
                        ],
                        "properties": {
                            "user_language": {
                                "type": "string",
                                "minLength": 2,
                                "maxLength": 32
                            },
                            "response_language": {
                                "type": "string",
                                "minLength": 2,
                                "maxLength": 32
                            }
                        },
                        "default": null
                    },
                    "detected_tasks": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 6,
                        "items": {
                            "type": "string",
                            "enum": [
                                "solve",
                                "simplify",
                                "factor",
                                "expand",
                                "evaluate",
                                "equation",
                                "inequality",
                                "system",
                                "word_problem",
                                "geometry",
                                "trigonometry",
                                "calculus",
                                "probability",
                                "statistics",
                                "linear_algebra",
                                "discrete_math",
                                "proof",
                                "graph",
                                "plot",
                                "other"
                            ]
                        }
                    }
                }
            },
            "classification": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "grade_band",
                    "domain",
                    "difficulty"
                ],
                "properties": {
                    "grade_band": {
                        "type": "string",
                        "enum": [
                            "grades_6_8",
                            "grades_9_10",
                            "grades_11_12",
                            "college_intro",
                            "undergraduate_lower",
                            "undergraduate_upper",
                            "graduate"
                        ]
                    },
                    "domain": {
                        "type": "string",
                        "enum": [
                            "arithmetic",
                            "pre_algebra",
                            "algebra",
                            "geometry",
                            "trigonometry",
                            "precalculus",
                            "calculus",
                            "linear_algebra",
                            "analysis",
                            "number_theory",
                            "discrete_math",
                            "discrete",
                            "probability",
                            "statistics",
                            "optimization",
                            "differential_equations",
                            "dynamical_systems",
                            "numerical_analysis",
                            "abstract_algebra",
                            "numerical_methods",
                            "complex_analysis",
                            "topology",
                            "applied_math",
                            "other"
                        ]
                    },
                    "topic": {
                        "type": "string",
                        "maxLength": 4000,
                        "default": ""
                    },
                    "difficulty": {
                        "type": "string",
                        "enum": [
                            "easy",
                            "medium",
                            "hard"
                        ]
                    }
                }
            },
            "step": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "index",
                    "title",
                    "explanation",
                    "math_latex"
                ],
                "properties": {
                    "index": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 2
                    },
                    "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                    },
                    "explanation": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                    },
                    "math_latex": {
                        "type": "array",
                        "minItems": 0,
                        "maxItems": 6,
                        "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 20000
                        },
                        "default": []
                    }
                }
            },
            "final_answer": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "answer_text",
                    "answer_latex",
                    "values",
                    "units"
                ],
                "properties": {
                    "answer_text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 20000
                    },
                    "answer_latex": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 20000
                    },
                    "values": {
                        "type": "array",
                        "minItems": 0,
                        "maxItems": 20,
                        "items": {
                            "$ref": "#/$defs/value_item"
                        },
                        "default": []
                    },
                    "units": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 2000
                    }
                }
            },
            "value_item": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "label",
                    "value",
                    "value_latex"
                ],
                "properties": {
                    "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                    },
                    "value": {
                        "type": [
                            "string",
                            "number",
                            "integer",
                            "boolean",
                            "null"
                        ]
                    },
                    "value_latex": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 20000
                    }
                }
            },
            "quality": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "confidence",
                    "common_mistakes"
                ],
                "properties": {
                    "confidence": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                    },
                    "common_mistakes": {
                        "type": "array",
                        "minItems": 0,
                        "maxItems": 3,
                        "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 300
                        },
                        "default": []
                    }
                }
            },
            "debug": {
                "type": [
                    "object",
                    "null"
                ],
                "additionalProperties": false,
                "required": [
                    "request_id",
                    "model",
                    "provider",
                    "input_tokens",
                    "output_tokens",
                    "total_tokens",
                    "latency_ms_total",
                    "finish_reason",
                    "truncated"
                ],
                "properties": {
                    "request_id": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 200
                    },
                    "model": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 200
                    },
                    "provider": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 100
                    },
                    "input_tokens": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "minimum": 0
                    },
                    "output_tokens": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "minimum": 0
                    },
                    "total_tokens": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "minimum": 0
                    },
                    "latency_ms_total": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "minimum": 0
                    },
                    "finish_reason": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 100
                    },
                    "truncated": {
                        "type": [
                            "boolean",
                            "null"
                        ]
                    }
                },
                "default": null
            }
        }
    }
}