{
    "type": "json_schema",
    "name": "solve_standard_detailed_v1",
    "strict": true,
    "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://youask.ai/schemas/solve_standard_detailed_v1.schema.json",
        "title": "YouAsk Solver Output Schema (Standard Detailed) (Matplotlib Recipes)",
        "description": "Strict JSON schema for standard (non-research) math tutoring output with optional plot recipes rendered server-side via matplotlib.",
        "type": "object",
        "additionalProperties": false,
        "required": [
            "schema_version",
            "refusal",
            "assumptions",
            "problem",
            "classification",
            "steps",
            "final_answer",
            "visuals",
            "quality",
            "debug",
            "_raw_llm_output"
        ],
        "properties": {
            "schema_version": {
                "type": "string",
                "enum": [
                    "v1"
                ]
            },
            "refusal": {
                "$ref": "#/$defs/refusal"
            },
            "assumptions": {
                "type": "array",
                "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                },
                "minItems": 0,
                "maxItems": 10,
                "default": []
            },
            "problem": {
                "$ref": "#/$defs/problem"
            },
            "classification": {
                "$ref": "#/$defs/classification"
            },
            "steps": {
                "type": "array",
                "items": {
                    "$ref": "#/$defs/step"
                },
                "minItems": 1,
                "maxItems": 24
            },
            "final_answer": {
                "$ref": "#/$defs/final_answer"
            },
            "visuals": {
                "$ref": "#/$defs/visuals"
            },
            "quality": {
                "$ref": "#/$defs/quality"
            },
            "debug": {
                "$ref": "#/$defs/debug"
            },
            "_raw_llm_output": {
                "type": [
                    "string",
                    "null"
                ],
                "maxLength": 500000
            }
        },
        "$defs": {
            "numOrNull": {
                "type": [
                    "number",
                    "null"
                ]
            },
            "refusal": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "is_refusal",
                    "reason",
                    "safe_alternative"
                ],
                "properties": {
                    "is_refusal": {
                        "type": "boolean"
                    },
                    "reason": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 20000
                    },
                    "safe_alternative": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 20000
                    }
                }
            },
            "problem": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "original_text",
                    "normalized_text",
                    "language",
                    "detected_tasks"
                ],
                "properties": {
                    "original_text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200000
                    },
                    "normalized_text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200000
                    },
                    "language": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "user_language",
                            "response_language"
                        ],
                        "properties": {
                            "user_language": {
                                "type": "string",
                                "minLength": 2,
                                "maxLength": 32
                            },
                            "response_language": {
                                "type": "string",
                                "minLength": 2,
                                "maxLength": 32
                            }
                        }
                    },
                    "detected_tasks": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 6,
                        "items": {
                            "type": "string",
                            "enum": [
                                "solve",
                                "simplify",
                                "factor",
                                "expand",
                                "evaluate",
                                "equation",
                                "inequality",
                                "system",
                                "word_problem",
                                "geometry",
                                "trigonometry",
                                "calculus",
                                "probability",
                                "statistics",
                                "linear_algebra",
                                "discrete_math",
                                "proof",
                                "graph",
                                "plot",
                                "other"
                            ]
                        }
                    }
                }
            },
            "classification": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "grade_band",
                    "domain",
                    "topic",
                    "difficulty"
                ],
                "properties": {
                    "grade_band": {
                        "type": "string",
                        "enum": [
                            "grades_6_8",
                            "grades_9_10",
                            "grades_11_12",
                            "college_intro",
                            "undergraduate_lower",
                            "undergraduate_upper",
                            "graduate"
                        ]
                    },
                    "domain": {
                        "type": "string",
                        "enum": [
                            "arithmetic",
                            "pre_algebra",
                            "algebra",
                            "geometry",
                            "trigonometry",
                            "precalculus",
                            "calculus",
                            "linear_algebra",
                            "analysis",
                            "number_theory",
                            "discrete_math",
                            "discrete",
                            "probability",
                            "statistics",
                            "optimization",
                            "differential_equations",
                            "dynamical_systems",
                            "numerical_analysis",
                            "abstract_algebra",
                            "numerical_methods",
                            "complex_analysis",
                            "topology",
                            "applied_math",
                            "other"
                        ]
                    },
                    "topic": {
                        "type": "string",
                        "maxLength": 20000,
                        "default": ""
                    },
                    "difficulty": {
                        "type": "string",
                        "enum": [
                            "easy",
                            "medium",
                            "hard"
                        ]
                    }
                }
            },
            "step": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "index",
                    "title",
                    "explanation",
                    "math_latex",
                    "rules_used",
                    "plots_used",
                    "checks",
                    "notes"
                ],
                "properties": {
                    "index": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 200
                    },
                    "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                    },
                    "explanation": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 20000
                    },
                    "math_latex": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200000
                        },
                        "minItems": 0,
                        "maxItems": 30,
                        "default": []
                    },
                    "rules_used": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 500
                        },
                        "minItems": 0,
                        "maxItems": 8,
                        "default": []
                    },
                    "plots_used": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "enum": [
                                "none",
                                "function_2d",
                                "scatter_2d",
                                "time_series",
                                "phase_portrait",
                                "poincare",
                                "bifurcation",
                                "histogram",
                                "custom"
                            ]
                        },
                        "minItems": 0,
                        "maxItems": 4,
                        "default": []
                    },
                    "checks": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 500
                        },
                        "minItems": 0,
                        "maxItems": 6,
                        "default": []
                    },
                    "notes": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 20000,
                        "default": null
                    }
                }
            },
            "final_answer": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "answer_text",
                    "answer_latex",
                    "values",
                    "units"
                ],
                "properties": {
                    "answer_text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200000
                    },
                    "answer_latex": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 200000
                    },
                    "values": {
                        "type": "array",
                        "items": {
                            "$ref": "#/$defs/value_item"
                        },
                        "minItems": 0,
                        "maxItems": 50,
                        "default": []
                    },
                    "units": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 2000
                    }
                }
            },
            "value_item": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "label",
                    "value",
                    "value_latex"
                ],
                "properties": {
                    "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                    },
                    "value": {
                        "type": [
                            "string",
                            "number",
                            "integer",
                            "boolean",
                            "null"
                        ]
                    },
                    "value_latex": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 200000
                    }
                }
            },
            "visuals": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "should_visualize",
                    "decision_reason",
                    "plots",
                    "alternative_visual"
                ],
                "properties": {
                    "should_visualize": {
                        "type": "boolean"
                    },
                    "decision_reason": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 20000
                    },
                    "plots": {
                        "type": "array",
                        "items": {
                            "$ref": "#/$defs/plot"
                        },
                        "minItems": 0,
                        "maxItems": 8,
                        "default": []
                    },
                    "alternative_visual": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "additionalProperties": false,
                        "required": [
                            "kind",
                            "description",
                            "data"
                        ],
                        "properties": {
                            "kind": {
                                "type": "string",
                                "enum": [
                                    "none",
                                    "table",
                                    "ascii",
                                    "explanation"
                                ]
                            },
                            "description": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 20000
                            },
                            "data": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 200000
                            }
                        },
                        "default": null
                    }
                }
            },
            "plot": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "kind",
                    "title",
                    "subtitle",
                    "x_label",
                    "y_label",
                    "z_label",
                    "domain",
                    "series",
                    "key_points",
                    "render_hint",
                    "recipe",
                    "rendered"
                ],
                "properties": {
                    "kind": {
                        "type": "string",
                        "enum": [
                            "function_2d",
                            "scatter_2d",
                            "time_series",
                            "phase_portrait",
                            "poincare",
                            "bifurcation",
                            "histogram",
                            "image",
                            "custom"
                        ]
                    },
                    "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 20000
                    },
                    "subtitle": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 20000
                    },
                    "x_label": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 2000
                    },
                    "y_label": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 2000
                    },
                    "z_label": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 2000
                    },
                    "domain": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "additionalProperties": false,
                        "required": [
                            "x_min",
                            "x_max",
                            "y_min",
                            "y_max"
                        ],
                        "properties": {
                            "x_min": {
                                "$ref": "#/$defs/numOrNull"
                            },
                            "x_max": {
                                "$ref": "#/$defs/numOrNull"
                            },
                            "y_min": {
                                "$ref": "#/$defs/numOrNull"
                            },
                            "y_max": {
                                "$ref": "#/$defs/numOrNull"
                            }
                        },
                        "default": null
                    },
                    "series": {
                        "description": "Optional lightweight series for simple plots only (avoid large arrays).",
                        "type": "array",
                        "items": {
                            "$ref": "#/$defs/plot_series"
                        },
                        "minItems": 0,
                        "maxItems": 6,
                        "default": []
                    },
                    "key_points": {
                        "type": "array",
                        "items": {
                            "$ref": "#/$defs/key_point"
                        },
                        "minItems": 0,
                        "maxItems": 20,
                        "default": []
                    },
                    "render_hint": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "preferred",
                            "notes"
                        ],
                        "properties": {
                            "preferred": {
                                "type": "string",
                                "enum": [
                                    "matplotlib",
                                    "plotly",
                                    "none"
                                ]
                            },
                            "notes": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "maxLength": 4000,
                                "default": null
                            }
                        }
                    },
                    "recipe": {
                        "description": "Instructions-only. Backend generates plots with matplotlib/numpy/sympy.",
                        "type": [
                            "object",
                            "null"
                        ],
                        "additionalProperties": false,
                        "required": [
                            "generator",
                            "expr",
                            "symbols",
                            "system",
                            "params",
                            "initial_conditions",
                            "sampling",
                            "sweep",
                            "data_ref"
                        ],
                        "properties": {
                            "generator": {
                                "type": "string",
                                "enum": [
                                    "function_2d",
                                    "ode_system",
                                    "poincare",
                                    "bifurcation_sweep",
                                    "data_ref",
                                    "custom"
                                ]
                            },
                            "expr": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "maxLength": 200000,
                                "default": null
                            },
                            "symbols": {
                                "type": "array",
                                "items": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 50
                                },
                                "minItems": 0,
                                "maxItems": 10,
                                "default": []
                            },
                            "system": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "maxLength": 2000,
                                "default": null
                            },
                            "params": {
                                "type": [
                                    "object",
                                    "null"
                                ],
                                "additionalProperties": false,
                                "required": [
                                    "zeta",
                                    "beta",
                                    "omega",
                                    "gamma"
                                ],
                                "properties": {
                                    "zeta": {
                                        "$ref": "#/$defs/numOrNull"
                                    },
                                    "beta": {
                                        "$ref": "#/$defs/numOrNull"
                                    },
                                    "omega": {
                                        "$ref": "#/$defs/numOrNull"
                                    },
                                    "gamma": {
                                        "$ref": "#/$defs/numOrNull"
                                    }
                                },
                                "default": null
                            },
                            "initial_conditions": {
                                "type": [
                                    "object",
                                    "null"
                                ],
                                "additionalProperties": false,
                                "required": [
                                    "x0",
                                    "v0"
                                ],
                                "properties": {
                                    "x0": {
                                        "$ref": "#/$defs/numOrNull"
                                    },
                                    "v0": {
                                        "$ref": "#/$defs/numOrNull"
                                    }
                                },
                                "default": null
                            },
                            "sampling": {
                                "type": [
                                    "object",
                                    "null"
                                ],
                                "additionalProperties": false,
                                "required": [
                                    "t_min",
                                    "t_max",
                                    "dt",
                                    "samples",
                                    "discard",
                                    "samples_per_period",
                                    "transient_periods",
                                    "keep_periods"
                                ],
                                "properties": {
                                    "t_min": {
                                        "$ref": "#/$defs/numOrNull"
                                    },
                                    "t_max": {
                                        "$ref": "#/$defs/numOrNull"
                                    },
                                    "dt": {
                                        "$ref": "#/$defs/numOrNull"
                                    },
                                    "samples": {
                                        "type": [
                                            "integer",
                                            "null"
                                        ],
                                        "minimum": 1,
                                        "default": null
                                    },
                                    "discard": {
                                        "type": [
                                            "integer",
                                            "null"
                                        ],
                                        "minimum": 0,
                                        "default": null
                                    },
                                    "samples_per_period": {
                                        "type": [
                                            "integer",
                                            "null"
                                        ],
                                        "minimum": 10,
                                        "default": null
                                    },
                                    "transient_periods": {
                                        "type": [
                                            "integer",
                                            "null"
                                        ],
                                        "minimum": 0,
                                        "default": null
                                    },
                                    "keep_periods": {
                                        "type": [
                                            "integer",
                                            "null"
                                        ],
                                        "minimum": 1,
                                        "default": null
                                    }
                                },
                                "default": null
                            },
                            "sweep": {
                                "type": [
                                    "object",
                                    "null"
                                ],
                                "additionalProperties": false,
                                "required": [
                                    "param",
                                    "min",
                                    "max",
                                    "steps"
                                ],
                                "properties": {
                                    "param": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "maxLength": 2000,
                                        "default": null
                                    },
                                    "min": {
                                        "$ref": "#/$defs/numOrNull"
                                    },
                                    "max": {
                                        "$ref": "#/$defs/numOrNull"
                                    },
                                    "steps": {
                                        "type": [
                                            "integer",
                                            "null"
                                        ],
                                        "minimum": 2,
                                        "default": null
                                    }
                                },
                                "default": null
                            },
                            "data_ref": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "maxLength": 2000,
                                "default": null
                            }
                        },
                        "default": null
                    },
                    "rendered": {
                        "description": "Filled by backend after matplotlib rendering.",
                        "type": [
                            "object",
                            "null"
                        ],
                        "additionalProperties": false,
                        "required": [
                            "image_ref",
                            "mime",
                            "width_px",
                            "height_px",
                            "caption"
                        ],
                        "properties": {
                            "image_ref": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "maxLength": 2000
                            },
                            "mime": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "maxLength": 100
                            },
                            "width_px": {
                                "type": [
                                    "integer",
                                    "null"
                                ],
                                "minimum": 1
                            },
                            "height_px": {
                                "type": [
                                    "integer",
                                    "null"
                                ],
                                "minimum": 1
                            },
                            "caption": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "maxLength": 20000
                            }
                        },
                        "default": null
                    }
                }
            },
            "plot_series": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "name",
                    "x",
                    "y",
                    "mode"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                    },
                    "x": {
                        "type": "array",
                        "items": {
                            "type": [
                                "number",
                                "string"
                            ]
                        },
                        "minItems": 0,
                        "maxItems": 200,
                        "default": []
                    },
                    "y": {
                        "type": "array",
                        "items": {
                            "type": [
                                "number",
                                "string"
                            ]
                        },
                        "minItems": 0,
                        "maxItems": 200,
                        "default": []
                    },
                    "mode": {
                        "type": "string",
                        "enum": [
                            "lines",
                            "markers",
                            "lines+markers",
                            "bars"
                        ]
                    }
                }
            },
            "key_point": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "label",
                    "x",
                    "y"
                ],
                "properties": {
                    "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                    },
                    "x": {
                        "type": [
                            "number",
                            "string",
                            "null"
                        ]
                    },
                    "y": {
                        "type": [
                            "number",
                            "string",
                            "null"
                        ]
                    }
                }
            },
            "quality": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "confidence",
                    "common_mistakes"
                ],
                "properties": {
                    "confidence": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                    },
                    "common_mistakes": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 500
                        },
                        "minItems": 0,
                        "maxItems": 5,
                        "default": []
                    }
                }
            },
            "debug": {
                "type": [
                    "object",
                    "null"
                ],
                "additionalProperties": false,
                "required": [
                    "request_id",
                    "model",
                    "provider",
                    "input_tokens",
                    "output_tokens",
                    "total_tokens",
                    "latency_ms_total",
                    "finish_reason",
                    "truncated"
                ],
                "properties": {
                    "request_id": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 200
                    },
                    "model": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 200
                    },
                    "provider": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 100
                    },
                    "input_tokens": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "minimum": 0
                    },
                    "output_tokens": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "minimum": 0
                    },
                    "total_tokens": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "minimum": 0
                    },
                    "latency_ms_total": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "minimum": 0
                    },
                    "finish_reason": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 100
                    },
                    "truncated": {
                        "type": [
                            "boolean",
                            "null"
                        ]
                    }
                },
                "default": null
            }
        }
    }
}