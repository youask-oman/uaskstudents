OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL_TUTOR=gpt-4o
OPENAI_MODEL_ESCALATE=o1
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_DEFAULT=gpt-5-mini
SOLVER_V2_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# LLM Provider Selection
LLM_PROVIDER=ollama
LLM_FALLBACK_ENABLED=true
LLM_DEBUG_LOGS=false
LLM_REPAIR_ENABLED=true

# Ollama Configuration
OLLAMA_BASE_URL=http://172.26.131.128:11434
OLLAMA_MODEL_DEFAULT=mightykatun/qwen2.5-math:7b
OLLAMA_TIMEOUT_SECONDS=30
OLLAMA_MAX_RETRIES=1
OLLAMA_KEEPALIVE=5m
OLLAMA_CONTEXT_TOKENS=4096
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_P=0.9

# Cache Configuration
CANONICAL_CACHE_ENABLED=true
SEMANTIC_CACHE_ENABLED=false
CACHE_WRITE_ENABLED=true
CACHE_DEBUG_LOGS=true

# OCR Engine Configuration
OCR_ENGINE=vlm
VLM_MODEL_OCR=gpt-4o
NEXT_PUBLIC_MATH_RENDERER=katex
NEXT_PUBLIC_MATH_ENGINE=mathjax
FEATURE_LOCAL_FIND_ERROR=true
WHATSAPP_OCR_ENABLED=true
WHATSAPP_AUTH_DIR=/app/storage/whatsapp_auth
WHATSAPP_INTERNAL_PORT=8791
WHATSAPP_INTERNAL_SEND_URL=http://orchestrator:8791/send
WHATSAPP_INTERNAL_KEY=replace_with_secret
WHATSAPP_LATEX_RENDER_ENABLED=true
WHATSAPP_LATEX_SCALE=1.0
WHATSAPP_LATEX_MAX_WIDTH=600
WHATSAPP_LATEX_MAX_HEIGHT=350
OPENAI_TIMEOUT_SECONDS=90
OPENAI_SOLVER_MAX_RETRIES=2
WHATSAPP_LATEX_RENDER_ENGINE=mathjax
NEXT_PUBLIC_API_FALLBACK_URL=http://127.0.0.1:8000
WORKER_CONCURRENCY=6
WHATSAPP_WORKER_CONCURRENCY=3
WHATSAPP_SOLVE_RATE_LIMIT=30/m
WHATSAPP_OCR_RATE_LIMIT=20/m
WHATSAPP_LATEX_IMAGE_FORMAT=webp
WHATSAPP_LATEX_RETURN_SVG=false

NEXT_PUBLIC_SNAP_SOLVE_UPLOAD_PANEL_V2=true
